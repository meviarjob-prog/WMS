&НаСервере
Функция НайтиМенеджерСправочникаСкладов()

	Имена = Новый Массив;
	Имена.Добавить("Склады");
	Имена.Добавить("СтруктурныеЕдиницы");
	Имена.Добавить("МестаХранения");
	Имена.Добавить("Хранилища");

	Для Каждого Имя Из Имена Цикл

		Если Метаданные.Справочники.Найти(
			Имя) <> Неопределено Тогда

			Возврат Справочники[Имя];
		КонецЕсли;

	КонецЦикла;

	ВызватьИсключение
		"Не найден справочник складов. Проверены: "
		+ СтрСоединить(Имена, ", ") + ".";

КонецФункции

&НаСервере
Функция НайтиСкладПоИмени(
	Имя)

	Склад =
		НайтиМенеджерСправочникаСкладов().НайтиПоНаименованию(
			Имя,
			Истина);

	Если Склад.Пустая() Тогда
		ВызватьИсключение
			"Не найден склад по точному наименованию: """
			+ Имя + """";
	КонецЕсли;

	Возврат Склад;

КонецФункции

&НаСервере
Процедура УстановитьРеквизитСклада(
	Документ,
	МассивИмен,
	Значение,
	Описание)

	МетаОбъект = Документ.Метаданные();

	Для Каждого Имя Из МассивИмен Цикл

		Если МетаОбъект.Реквизиты.Найти(
			Имя) <> Неопределено Тогда

			Документ[Имя] = Значение;
			Возврат;
		КонецЕсли;

	КонецЦикла;

	ВызватьИсключение
		"В документе """ + МетаОбъект.Синоним
		+ """ не найден реквизит " + Описание
		+ ". Проверены: "
		+ СтрСоединить(МассивИмен, ", ");

КонецПроцедуры

