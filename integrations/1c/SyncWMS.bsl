// SyncWMS.bsl
// Синхронизация WMS -> 1С.
//
// Основной принцип:
//   barcode WMS -> ссылка на Справочник.Номенклатура
//   -> заполнение зависимых реквизитов
//   -> проверка строки до и после записи документа.
//
// Документ создается программно (СоздатьДокумент + Записать), без формы —
// обработчики "при изменении" полей формы тут не участвуют, порядок
// присвоения реквизитов сам по себе ни на что не влияет. Проверка после
// записи нужна на случай, если что-то меняет модуль самого документа.
//
// ВАЖНО:
// 1. Токен не хранится в исходнике. Заполните реквизит формы ТокенWMS.
// 2. Документы не проводятся.
// 3. Если строку нельзя однозначно сопоставить с Номенклатурой,
//    документ не записывается и WMS не подтверждается.
// 4. Диагностика пишется в журнал регистрации "ОбменWMS".

&НаКлиенте
Процедура ФормаСинхронизировать(Команда)
	Результат = СинхронизироватьНаСервере();

	// Сообщить (пишет в панель сообщений, остается видимым) вместо
	// Оповестить (всплывающий тост, легко пропустить, особенно если окно
	// 1С не в фокусе или системные уведомления отключены).
	Сообщить(
		"WMS: " + Результат,
		СтатусСообщения.Важное);
КонецПроцедуры

// Кнопку "Тестовый прогон" нужно добавить на форму так же, как
// "Синхронизировать" (с этим же обработчиком). Прогоняет ровно тот же
// код, что и настоящая синхронизация, но с заранее заданными
// номенклатурой/штрихкодом/количеством вместо реального ответа WMS —
// без HTTP-запроса и без зависимости от остатков на складе. Удобно,
// чтобы быстро проверять сопоставление и запись документа отдельно от
// самого WMS.
&НаКлиенте
Процедура ФормаТестовыйПрогон(Команда)
	Результат = ТестовыйПрогонНаСервере();
	Сообщить(
		"Тест: " + Результат,
		СтатусСообщения.Важное);
КонецПроцедуры

// Кнопку "Тестовый прогон возврата" — так же, с этим же обработчиком.
// Отдельно от "Тестового прогона" перемещения, т.к. возврат поставщику
// устроен сложнее (поиск Заказа поставщику + автоопределение операции) и
// именно там чаще всего вылезают особенности конкретной базы — быстрее
// проверять его в Конфигураторе, чем гонять реальную приемку через WMS.
&НаКлиенте
Процедура ФормаТестовыйПрогонВозврата(Команда)
	Результат = ТестовыйПрогонВозвратаНаСервере();
	Сообщить(
		"Тест возврата: " + Результат,
		СтатусСообщения.Важное);
КонецПроцедуры

&НаСервере
Функция ТестовыйПрогонНаСервере()

	// ⚠️ Проставьте реальные названия складов из вашей базы (как они
	// называются в справочнике складов) перед запуском теста.
	СкладОтправитель = "УКАЖИТЕ СКЛАД-ОТПРАВИТЕЛЬ";
	СкладПолучатель = "УКАЖИТЕ СКЛАД-ПОЛУЧАТЕЛЬ";

	Строка = Новый Структура;
	Строка.Вставить("barcode", "12345678");
	Строка.Вставить("name", "Свитер свитерро 50-54");
	Строка.Вставить("qty", 5);

	Линии = Новый Массив;
	Линии.Добавить(Строка);

	ТестовыеДанные = Новый Структура;
	ТестовыеДанные.Вставить("number", "TEST-0001");
	ТестовыеДанные.Вставить("comment", "WMS: TEST-0001 (тестовый прогон, не из WMS)");
	ТестовыеДанные.Вставить("from_warehouse", СкладОтправитель);
	ТестовыеДанные.Вставить("to_warehouse", СкладПолучатель);
	ТестовыеДанные.Вставить("lines", Линии);

	Попытка
		СоздатьПеремещениеТоваров(ТестовыеДанные);
	Исключение
		Возврат "ошибка: " + ОписаниеОшибки();
	КонецПопытки;

	Возврат "документ TEST-0001 создан — смотрите журнал регистрации ""ОбменWMS"" и сам документ";

КонецФункции

// Тестовый прогон именно возврата поставщику — отдельно от перемещения,
// т.к. у возврата больше специфики под конкретную базу (поиск Заказа
// поставщику по номеру, автоопределение реквизита/значения "Операция" на
// РасходнойНакладной в 1С:УНФ). Без HTTP-запроса, без реальной приемки в
// WMS — сразу видно, что пошло не так, в журнале регистрации "ОбменWMS".
&НаСервере
Функция ТестовыйПрогонВозвратаНаСервере()

	// ⚠️ Подставьте реальные значения из вашей базы перед запуском:
	// склад — как он называется в справочнике складов; номер заявки —
	// либо полный номер существующего "Заказа поставщику" (реквизит
	// "Номер", например "ШМ-005" — тогда сработает точное совпадение и
	// поставщик ниже роли не играет), либо короткое число из заголовка
	// формы (например "5") — тогда ОБЯЗАТЕЛЬНО укажите настоящее название
	// поставщика этого заказа: у разных заказов "голые" цифры номера
	// часто совпадают (например "ОЗ-К05" и "ШМ-005" — у обоих "5"), и без
	// проверки поставщика можно случайно привязать возврат не к тому
	// заказу — см. НайтиЗаказПоставщикуПоНомеру.
	Склад = "Склад №2 (Шоссейная 167)";
	НомерЗаявки = "ШМ-005";
	ПоставщикЗаявки = "Хубиева Аза Магометовна ИП";
	// ИНН поставщика — необязательно, но надежнее имени (см. комментарий
	// у ИННСовпадает/НайтиКонтрагентаПоИНН): "Наименование" в справочнике
	// контрагентов часто внутренний алиас, не совпадающий с текстом из
	// накладной. Если знаете ИНН тестового поставщика — впишите сюда.
	ПоставщикИНН = "";

	// Реальный штрихкод/название из уже загруженной в базу номенклатуры —
	// иначе тест закономерно упадет на "не удалось сопоставить строку",
	// это не ошибка кода, просто нет такого товара в справочнике.
	Строка = Новый Структура;
	Строка.Вставить("barcode", "2053634196302");
	Строка.Вставить("name", "Мевиар_с_ушками_и_завязками_лиловая MEVIAR Kids / Шапки (44-46)");
	Строка.Вставить("qty", 1);

	Линии = Новый Массив;
	Линии.Добавить(Строка);

	ТестовыеДанные = Новый Структура;
	ТестовыеДанные.Вставить("invoice_number", "TEST-RETURN-0001");
	ТестовыеДанные.Вставить("order_number", НомерЗаявки);
	ТестовыеДанные.Вставить("supplier", ПоставщикЗаявки);
	ТестовыеДанные.Вставить("supplier_inn", ПоставщикИНН);
	ТестовыеДанные.Вставить("warehouse", Склад);
	ТестовыеДанные.Вставить(
		"comment",
		"WMS: тестовый возврат (тестовый прогон, не из WMS)");
	ТестовыеДанные.Вставить("lines", Линии);

	Попытка
		СоздатьВозвратПоставщику(ТестовыеДанные);
	Исключение
		Возврат "ошибка: " + ОписаниеОшибки();
	КонецПопытки;

	Возврат
		"тестовый возврат создан — смотрите журнал регистрации "
		+ """ОбменWMS"" и сам документ";

КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если ПустаяСтрока(Объект.АдресWMS) Тогда
		Объект.АдресWMS = "https://wms.wmsmeviar.ru";
	КонецЕсли;

	// Токен намеренно не прописываем в исходнике.
	// Он должен находиться в реквизите формы ТокенWMS.

КонецПроцедуры

// ============================================================================
// СИНХРОНИЗАЦИЯ
// ============================================================================

&НаСервере
Функция СинхронизироватьНаСервере()

	Ответ = ЗапроситьДокументыWMS();

	Если Ответ = Неопределено Тогда
		Возврат "не удалось получить документы (см. журнал регистрации)";
	КонецЕсли;

	ПеренесенныеПеремещения = Новый Массив;
	ПеренесенныеИнвентаризации = Новый Массив;
	ПеренесенныеВозвраты = Новый Массив;
	ПеренесенныеКорректировкиПриемки = Новый Массив;
	ПеренесенныеКорректировкиПеремещений = Новый Массив;
	Ошибки = Новый Массив;
	// Ключ — Строка(id) перемещения WMS, значение — текст того, какие
	// строки не сопоставились и были пропущены (см. СоздатьПеремещениеТоваров).
	// Пустой Структура — предупреждений нет вообще, тогда WMS ничего не
	// показывает; непустая — WMS ставит "!" у документа в списке
	// перемещений (см. MovementDocument.sync_warning / export_confirm).
	ПредупрежденияПеремещений = Новый Структура;

	МассивПеремещений = ПолучитьСвойствоИлиПустойМассив(Ответ, "movements");

	Для Каждого ДокПеремещения Из МассивПеремещений Цикл
		Попытка
			ПредупрежденияСтрок =
				СоздатьПеремещениеТоваров(ДокПеремещения);

			Id = ПолучитьСвойство(ДокПеремещения, "id", Неопределено);

			ПеренесенныеПеремещения.Добавить(Id);

			Если ПредупрежденияСтрок.Количество() > 0 Тогда
				ПредупрежденияПеремещений.Вставить(
					Строка(Id),
					СтрСоединить(ПредупрежденияСтрок, "; "));
			КонецЕсли;
		Исключение
			Сообщение = "Перемещение "
				+ ПолучитьСтроковоеСвойство(ДокПеремещения, "number")
				+ ": " + ОписаниеОшибки();

			Ошибки.Добавить(Сообщение);

			ЗаписьЖурналаРегистрации(
				"ОбменWMS",
				УровеньЖурналаРегистрации.Ошибка,,,
				Сообщение);
		КонецПопытки;
	КонецЦикла;

	МассивИнвентаризаций = ПолучитьСвойствоИлиПустойМассив(
		Ответ,
		"inventories");

	Для Каждого ДокИнвентаризации Из МассивИнвентаризаций Цикл
		Попытка
			СоздатьИнвентаризациюТоваров(ДокИнвентаризации);
			ПеренесенныеИнвентаризации.Добавить(
				ПолучитьСвойство(ДокИнвентаризации, "id", Неопределено));
		Исключение
			Сообщение = "Инвентаризация "
				+ ПолучитьСтроковоеСвойство(ДокИнвентаризации, "number")
				+ ": " + ОписаниеОшибки();

			Ошибки.Добавить(Сообщение);

			ЗаписьЖурналаРегистрации(
				"ОбменWMS",
				УровеньЖурналаРегистрации.Ошибка,,,
				Сообщение);
		КонецПопытки;
	КонецЦикла;

	МассивВозвратов = ПолучитьСвойствоИлиПустойМассив(
		Ответ,
		"supplier_returns");

	Для Каждого ДокВозврата Из МассивВозвратов Цикл
		Попытка
			СоздатьВозвратПоставщику(ДокВозврата);
			ПеренесенныеВозвраты.Добавить(
				ПолучитьСвойство(ДокВозврата, "id", Неопределено));
		Исключение
			Сообщение = "Возврат поставщику по накладной "
				+ ПолучитьСтроковоеСвойство(ДокВозврата, "invoice_number")
				+ " (№ заявки: "
				+ ПолучитьСтроковоеСвойство(ДокВозврата, "order_number")
				+ "): " + ОписаниеОшибки();

			Ошибки.Добавить(Сообщение);

			ЗаписьЖурналаРегистрации(
				"ОбменWMS",
				УровеньЖурналаРегистрации.Ошибка,,,
				Сообщение);
		КонецПопытки;
	КонецЦикла;

	МассивКорректировокПриемки = ПолучитьСвойствоИлиПустойМассив(
		Ответ,
		"receiving_adjustments");

	Для Каждого ДокКорректировки Из МассивКорректировокПриемки Цикл
		Попытка
			СкорректироватьПриемку(ДокКорректировки);
			ПеренесенныеКорректировкиПриемки.Добавить(
				ПолучитьСвойство(ДокКорректировки, "id", Неопределено));
		Исключение
			Сообщение = "Корректировка количества в накладной "
				+ ПолучитьСтроковоеСвойство(ДокКорректировки, "invoice_number")
				+ ": " + ОписаниеОшибки();

			Ошибки.Добавить(Сообщение);

			ЗаписьЖурналаРегистрации(
				"ОбменWMS",
				УровеньЖурналаРегистрации.Ошибка,,,
				Сообщение);
		КонецПопытки;
	КонецЦикла;

	МассивКорректировокПеремещений = ПолучитьСвойствоИлиПустойМассив(
		Ответ,
		"movement_corrections");

	Для Каждого ДокКоррПеремещения Из МассивКорректировокПеремещений Цикл
		Попытка
			СкорректироватьПеремещение(ДокКоррПеремещения);
			ПеренесенныеКорректировкиПеремещений.Добавить(
				ПолучитьСвойство(ДокКоррПеремещения, "id", Неопределено));
		Исключение
			Сообщение = "Корректировка перемещения "
				+ ПолучитьСтроковоеСвойство(ДокКоррПеремещения, "number")
				+ ": " + ОписаниеОшибки();

			Ошибки.Добавить(Сообщение);

			ЗаписьЖурналаРегистрации(
				"ОбменWMS",
				УровеньЖурналаРегистрации.Ошибка,,,
				Сообщение);
		КонецПопытки;
	КонецЦикла;

	ПодтверждениеОтправлено = Истина;

	Если ПеренесенныеПеремещения.Количество() > 0
		Или ПеренесенныеИнвентаризации.Количество() > 0
		Или ПеренесенныеВозвраты.Количество() > 0
		Или ПеренесенныеКорректировкиПриемки.Количество() > 0
		Или ПеренесенныеКорректировкиПеремещений.Количество() > 0 Тогда

		ПодтверждениеОтправлено = ПодтвердитьПриемWMS(
			ПеренесенныеПеремещения,
			ПеренесенныеИнвентаризации,
			ПеренесенныеВозвраты,
			ПредупрежденияПеремещений,
			ПеренесенныеКорректировкиПриемки,
			ПеренесенныеКорректировкиПеремещений);

	КонецЕсли;

	Если Не ПодтверждениеОтправлено Тогда
		Возврат "создано перемещений "
			+ ПеренесенныеПеремещения.Количество()
			+ ", инвентаризаций "
			+ ПеренесенныеИнвентаризации.Количество()
			+ ", возвратов "
			+ ПеренесенныеВозвраты.Количество()
			+ ", корректировок приемки "
			+ ПеренесенныеКорректировкиПриемки.Количество()
			+ ", корректировок перемещений "
			+ ПеренесенныеКорректировкиПеремещений.Количество()
			+ ", но WMS не подтвердила прием";
	КонецЕсли;

	Результат = "перемещений "
		+ ПеренесенныеПеремещения.Количество()
		+ ", инвентаризаций "
		+ ПеренесенныеИнвентаризации.Количество()
		+ ", возвратов поставщику "
		+ ПеренесенныеВозвраты.Количество()
		+ ", корректировок приемки "
		+ ПеренесенныеКорректировкиПриемки.Количество()
		+ ", корректировок перемещений "
		+ ПеренесенныеКорректировкиПеремещений.Количество();

	Если Ошибки.Количество() > 0 Тогда
		// Текст ошибок дублируем прямо в итоговое сообщение (не только в
		// журнал регистрации) — если по какой-то причине запись в журнал
		// не видна (не тот фильтр, другой день на сервере и т.п.), причину
		// все равно будет видно сразу в этом же окне.
		Результат = Результат
			+ "; ошибок: " + Ошибки.Количество()
			+ Символы.ПС
			+ СтрСоединить(Ошибки, Символы.ПС);
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервере
Функция ЗапроситьДокументыWMS()

	Если ПустаяСтрока(Объект.ТокенWMS) Тогда
		ЗаписьЖурналаРегистрации(
			"ОбменWMS",
			УровеньЖурналаРегистрации.Ошибка,,,
			"Не заполнен реквизит ТокенWMS.");

		Возврат Неопределено;
	КонецЕсли;

	Соединение = НовоеHTTPСоединение();

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("X-1C-Token", Объект.ТокенWMS);

	Запрос = Новый HTTPЗапрос(
		"/integrations/1c/api/export",
		Заголовки);

	Попытка
		Ответ = Соединение.Получить(Запрос);
	Исключение
		ЗаписьЖурналаРегистрации(
			"ОбменWMS",
			УровеньЖурналаРегистрации.Ошибка,,,
			"Ошибка HTTP при получении документов WMS: "
			+ ОписаниеОшибки());

		Возврат Неопределено;
	КонецПопытки;

	Если Ответ = Неопределено
		Или Ответ.КодСостояния <> 200 Тогда

		Код = ?(
			Ответ = Неопределено,
			"нет ответа",
			Строка(Ответ.КодСостояния));

		ЗаписьЖурналаРегистрации(
			"ОбменWMS",
			УровеньЖурналаРегистрации.Ошибка,,,
			"WMS ответил кодом " + Код);

		Возврат Неопределено;
	КонецЕсли;

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(
			Ответ.ПолучитьТелоКакСтроку());

		Результат = ПрочитатьJSON(
			ЧтениеJSON,
			Ложь);

		ЧтениеJSON.Закрыть();

	Исключение
		ЗаписьЖурналаРегистрации(
			"ОбменWMS",
			УровеньЖурналаРегистрации.Ошибка,,,
			"Ошибка разбора JSON от WMS: "
			+ ОписаниеОшибки());

		Возврат Неопределено;
	КонецПопытки;

	Возврат Результат;

КонецФункции

&НаСервере
Функция ПодтвердитьПриемWMS(
	МассивПеремещений,
	МассивИнвентаризаций,
	МассивВозвратов,
	ПредупрежденияПеремещений = Неопределено,
	МассивКорректировокПриемки = Неопределено,
	МассивКорректировокПеремещений = Неопределено)

	Тело = Новый Соответствие;
	Тело.Вставить("movement_ids", МассивПеремещений);
	Тело.Вставить("inventory_ids", МассивИнвентаризаций);
	Тело.Вставить("supplier_return_ids", МассивВозвратов);
	Тело.Вставить(
		"receiving_adjustment_ids",
		?(МассивКорректировокПриемки = Неопределено, Новый Массив, МассивКорректировокПриемки));
	Тело.Вставить(
		"movement_correction_ids",
		?(МассивКорректировокПеремещений = Неопределено, Новый Массив, МассивКорректировокПеремещений));

	// Перемещения, где часть строк не сопоставилась с номенклатурой и была
	// пропущена (см. СоздатьПеремещениеТоваров) — WMS проставит у них "!"
	// в списке перемещений, чтобы бухгалтер/кладовщик знал, что документ в
	// 1С неполный и его нужно проверить/дозаполнить вручную.
	Если ПредупрежденияПеремещений <> Неопределено
		И ПредупрежденияПеремещений.Количество() > 0 Тогда

		Тело.Вставить(
			"movement_warnings",
			ПредупрежденияПеремещений);
	КонецЕсли;

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();

	ЗаписатьJSON(
		ЗаписьJSON,
		Тело);

	СтрокаТела = ЗаписьJSON.Закрыть();

	Соединение = НовоеHTTPСоединение();

	Заголовки = Новый Соответствие;
	Заголовки.Вставить(
		"X-1C-Token",
		Объект.ТокенWMS);

	Заголовки.Вставить(
		"Content-Type",
		"application/json");

	Запрос = Новый HTTPЗапрос(
		"/integrations/1c/api/export/confirm",
		Заголовки);

	Запрос.УстановитьТелоИзСтроки(СтрокаТела);

	Попытка
		Ответ = Соединение.ВызватьHTTPМетод(
			"POST",
			Запрос);
	Исключение
		ЗаписьЖурналаРегистрации(
			"ОбменWMS",
			УровеньЖурналаРегистрации.Ошибка,,,
			"Не удалось отправить подтверждение в WMS: "
			+ ОписаниеОшибки());

		Возврат Ложь;
	КонецПопытки;

	Если Ответ = Неопределено
		Или Ответ.КодСостояния < 200
		Или Ответ.КодСостояния >= 300 Тогда

		КодОтвета = ?(
			Ответ = Неопределено,
			"нет ответа",
			Строка(Ответ.КодСостояния));

		ЗаписьЖурналаРегистрации(
			"ОбменWMS",
			УровеньЖурналаРегистрации.Ошибка,,,
			"WMS не подтвердила прием документов, код ответа: "
			+ КодОтвета);

		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

&НаСервере
Функция НовоеHTTPСоединение()

	АдресРазобранный = СтрЗаменить(
		Объект.АдресWMS,
		"https://",
		"");

	АдресРазобранный = СтрЗаменить(
		АдресРазобранный,
		"http://",
		"");

	// На случай, если в адресе оставили конечный "/" — HTTPСоединение
	// ожидает только имя сервера, без пути.
	Пока СтрЗаканчиваетсяНа(
		АдресРазобранный,
		"/") Цикл

		АдресРазобранный =
			Лев(АдресРазобранный, СтрДлина(АдресРазобранный) - 1);
	КонецЦикла;

	ИспользоватьЗащищенное =
		СтрНачинаетсяС(
			Объект.АдресWMS,
			"https://");

	// Порт указываем явно (не полагаемся на дефолт платформы под протокол).
	Порт = ?(
		ИспользоватьЗащищенное,
		443,
		80);

	// ВАЖНО: используется конструктор HTTPСоединение("По указанному
	// серверу") — Сервер, Порт, Пользователь, Пароль, Прокси,
	// ЗащищенноеСоединение — ровно 6 параметров, ЗащищенноеСоединение
	// именно 6-й. Если дописать лишние пустые позиции перед ним (как было
	// раньше — 7 или 8 параметров), значение просто отбрасывается мимо
	// несуществующего параметра, а настоящий 6-й параметр остается пустым
	// (Ложь по умолчанию) — соединение всегда уходит обычным HTTP,
	// независимо от того, что написано в АдресWMS.
	Возврат Новый HTTPСоединение(
		АдресРазобранный,
		Порт,
		,,,
		ИспользоватьЗащищенное);

КонецФункции

// ============================================================================
// УТИЛИТЫ JSON
// ============================================================================

&НаСервере
Функция ПолучитьСвойство(
	Данные,
	Имя,
	ЗначениеПоУмолчанию = Неопределено)

	Если Данные = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Значение = Неопределено;

	Попытка
		Если Данные.Свойство(
			Имя,
			Значение) Тогда

			Возврат Значение;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

&НаСервере
Функция ПолучитьСтроковоеСвойство(
	Данные,
	Имя)

	Значение = ПолучитьСвойство(
		Данные,
		Имя,
		"");

	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат Строка(Значение);

КонецФункции

&НаСервере
Функция ПолучитьСвойствоИлиПустойМассив(
	Данные,
	Имя)

	Значение = ПолучитьСвойство(
		Данные,
		Имя,
		Неопределено);

	Если Значение = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Возврат Значение;

КонецФункции

&НаСервере
Функция ПолучитьПервоеЗаполненноеСвойство(
	Данные,
	Имена)

	Для Каждого Имя Из Имена Цикл

		Значение = ПолучитьСвойство(
			Данные,
			Имя,
			Неопределено);

		Если Значение <> Неопределено
			И ЗначениеЗаполнено(Значение) Тогда

			Возврат Значение;
		КонецЕсли;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// ============================================================================
// НОМЕНКЛАТУРА
// ============================================================================

// Ведущие нули НЕ удаляются.
&НаСервере
Функция НормализоватьШтрихкод(Штрихкод)

	Если Штрихкод = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Результат = СокрЛП(
		Строка(Штрихкод));

	Результат = СтрЗаменить(
		Результат,
		" ",
		"");

	Результат = СтрЗаменить(
		Результат,
		"-",
		"");

	Возврат Результат;

КонецФункции

// --- Поиск в справочнике ШтрихкодыНоменклатуры -------------------------------

&НаСервере
Функция НайтиНоменклатуруВСправочникеШтрихкодов(
	Штрихкод)

	Если Метаданные.Справочники.Найти(
		"ШтрихкодыНоменклатуры") = Неопределено Тогда

		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Запрос = Новый Запрос;

		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 2
			|	Штрихкоды.Владелец КАК Номенклатура
			|ИЗ
			|	Справочник.ШтрихкодыНоменклатуры КАК Штрихкоды
			|ГДЕ
			|	Штрихкоды.Штрихкод = &Штрихкод";

		Запрос.УстановитьПараметр(
			"Штрихкод",
			Штрихкод);

		Выборка = Запрос.Выполнить().Выбрать();

		Если Не Выборка.Следующий() Тогда
			Возврат Неопределено;
		КонецЕсли;

		Номенклатура = Выборка.Номенклатура;

		Если Выборка.Следующий() Тогда
			ВызватьИсключение
				"Штрихкод """ + Штрихкод
				+ """ привязан более чем к одной номенклатуре.";
		КонецЕсли;

		Возврат Номенклатура;

	Исключение
		ВызватьИсключение
			"Ошибка поиска в справочнике ШтрихкодыНоменклатуры: "
			+ ОписаниеОшибки();
	КонецПопытки;

КонецФункции

