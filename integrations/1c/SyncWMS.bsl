Функция НайтиТабличнуюЧастьТоваров(
	Документ)

	Имена = Новый Массив;
	Имена.Добавить("Товары");
	Имена.Добавить("Запасы");
	Имена.Добавить("Продукция");
	Имена.Добавить("Материалы");
