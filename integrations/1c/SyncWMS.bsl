// Обработчик кнопки "Синхронизировать" внешней обработки обмена с WMS.
// Реквизиты формы, которые нужно завести заранее:
//   АдресWMS  (Строка) — например "https://wms.wmsmeviar.ru"
//   ТокенWMS  (Строка) — токен из WMS: меню "Обмен с 1С" (только админ)
//
// Смысл: забрать из WMS завершенные и еще не перенесенные документы
// перемещения/инвентаризации, создать по ним черновики (НЕ проведенные)
// документов 1С с номером WMS-документа в комментарии, и подтвердить
// WMS, что документы приняты — чтобы при повторном нажатии кнопки они
// не создались еще раз.

// Имя процедуры-обработчика зависит от того, как 1С назвала команду при
// создании (обычно "Форма"+имя команды, например ФормаСинхронизировать) —
// если у вас команда называется иначе, переименуйте здесь.
&НаКлиенте
Процедура ФормаСинхронизировать(Команда)
	Результат = СинхронизироватьНаСервере();
	Оповестить("WMS: " + Результат);
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если ПустаяСтрока(Объект.АдресWMS) Тогда
		Объект.АдресWMS = "https://wms.wmsmeviar.ru";
	КонецЕсли;
	Если ПустаяСтрока(Объект.ТокенWMS) Тогда
		Объект.ТокенWMS = "ВСТАВЬТЕ_СЮДА_ТОКЕН_ИЗ_WMS";
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция СинхронизироватьНаСервере()

	Ответ = ЗапроситьДокументыWMS();
	Если Ответ = Неопределено Тогда
		Возврат "не удалось получить документы (см. журнал регистрации)";
	КонецЕсли;

	ПеренесенныеПеремещения = Новый Массив;
	ПеренесенныеИнвентаризации = Новый Массив;

	Для Каждого ДокПеремещения Из Ответ.movements Цикл
		Попытка
			СоздатьПеремещениеТоваров(ДокПеремещения);
			ПеренесенныеПеремещения.Добавить(ДокПеремещения.id);
		Исключение
			ЗаписьЖурналаРегистрации(
				"ОбменWMS",
				УровеньЖурналаРегистрации.Ошибка,,,
				"Перемещение " + ДокПеремещения.number + ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	Для Каждого ДокИнвентаризации Из Ответ.inventories Цикл
		Попытка
			СоздатьИнвентаризациюТоваров(ДокИнвентаризации);
			ПеренесенныеИнвентаризации.Добавить(ДокИнвентаризации.id);
		Исключение
			ЗаписьЖурналаРегистрации(
				"ОбменWMS",
				УровеньЖурналаРегистрации.Ошибка,,,
				"Инвентаризация " + ДокИнвентаризации.number + ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	ПодтверждениеОтправлено = Истина;
	Если ПеренесенныеПеремещения.Количество() > 0 Или ПеренесенныеИнвентаризации.Количество() > 0 Тогда
		ПодтверждениеОтправлено = ПодтвердитьПриемWMS(ПеренесенныеПеремещения, ПеренесенныеИнвентаризации);
	КонецЕсли;

	Если Не ПодтверждениеОтправлено Тогда
		Возврат "документы созданы (" + ПеренесенныеПеремещения.Количество() + " перемещ., "
			+ ПеренесенныеИнвентаризации.Количество() + " инвент.), НО WMS не подтвердила прием — "
			+ "при следующей синхронизации они создадутся заново! Смотрите журнал регистрации.";
	КонецЕсли;

	Возврат "перемещений " + ПеренесенныеПеремещения.Количество()
		+ ", инвентаризаций " + ПеренесенныеИнвентаризации.Количество();

КонецФункции

&НаСервере
Функция ЗапроситьДокументыWMS()

	Соединение = НовоеHTTPСоединение();
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("X-1C-Token", Объект.ТокенWMS);
	Запрос = Новый HTTPЗапрос("/integrations/1c/api/export", Заголовки);

	Ответ = Соединение.Получить(Запрос);
	Если Ответ.КодСостояния <> 200 Тогда
		ЗаписьЖурналаРегистрации("ОбменWMS", УровеньЖурналаРегистрации.Ошибка,,,
			"WMS ответил кодом " + Ответ.КодСостояния);
		Возврат Неопределено;
	КонецЕсли;

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
	Результат = ПрочитатьJSON(ЧтениеJSON, Ложь);
	ЧтениеJSON.Закрыть();
	Возврат Результат;

КонецФункции

&НаСервере
Функция ПодтвердитьПриемWMS(МассивПеремещений, МассивИнвентаризаций)

	Тело = Новый Соответствие;
	Тело.Вставить("movement_ids", МассивПеремещений);
	Тело.Вставить("inventory_ids", МассивИнвентаризаций);

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Тело);
	СтрокаТела = ЗаписьJSON.Закрыть();

	Соединение = НовоеHTTPСоединение();
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("X-1C-Token", Объект.ТокенWMS);
	Заголовки.Вставить("Content-Type", "application/json");
	Запрос = Новый HTTPЗапрос("/integrations/1c/api/export/confirm", Заголовки);
	Запрос.УстановитьТелоИзСтроки(СтрокаТела);

	Попытка
		Ответ = Соединение.Отправить(Запрос);
	Исключение
		ЗаписьЖурналаРегистрации("ОбменWMS", УровеньЖурналаРегистрации.Ошибка,,,
			"Не удалось отправить подтверждение в WMS: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;

	// Соединение.Отправить у HTTPСоединения возвращает то же, что и Получить —
	// объект ответа с КодСостояния. Если сайт вернул не 200 (например, 401
	// из-за неверного токена, или 500) — документы в WMS НЕ будут помечены
	// перенесенными, и при следующем нажатии кнопки создадутся заново. Это
	// самое частое место тихого сбоя — обязательно проверяем код ответа.
	Если Ответ = Неопределено Или Ответ.КодСостояния <> 200 Тогда
		КодОтвета = ?(Ответ = Неопределено, "нет ответа", Строка(Ответ.КодСостояния));
		ЗаписьЖурналаРегистрации("ОбменWMS", УровеньЖурналаРегистрации.Ошибка,,,
			"WMS не подтвердила прием документов, код ответа: " + КодОтвета);
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

&НаСервере
Функция НовоеHTTPСоединение()
	АдресРазобранный = СтрЗаменить(Объект.АдресWMS, "https://", "");
	АдресРазобранный = СтрЗаменить(АдресРазобранный, "http://", "");
	ИспользоватьЗащищенное = СтрНачинаетсяС(Объект.АдресWMS, "https://");
	Возврат Новый HTTPСоединение(АдресРазобранный,, , , , , ИспользоватьЗащищенное);
КонецФункции

// TODO: поправьте под вашу базу, если штрихкод хранится не в
// Справочники.ШтрихкодыНоменклатуры (стандарт для 1С:УНФ), а иначе —
// например, отдельным реквизитом справочника Номенклатура, или у
// характеристик товара (размер/цвет) свой штрихкод.
&НаСервере
Функция НайтиТоварПоШтрихкоду(Штрихкод)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Штрихкоды.Владелец КАК Номенклатура
		|ИЗ
		|	Справочник.ШтрихкодыНоменклатуры КАК Штрихкоды
		|ГДЕ
		|	Штрихкоды.Штрихкод = &Штрихкод";
	Запрос.УстановитьПараметр("Штрихкод", Штрихкод);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Номенклатура;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// TODO: если склады в WMS и 1С называются по-разному — замените поиск по
// имени на свою таблицу соответствия.
&НаСервере
Функция НайтиСкладПоИмени(Имя)
	Возврат Справочники.Склады.НайтиПоНаименованию(Имя, Истина);
КонецФункции

// Если у вас все же не 1С:УНФ или доработанная конфигурация и снова
// вылетит "Поле объекта не обнаружено" — попробуйте вместо
// СкладОтправитель/СкладПолучатель реквизиты СтруктурнаяЕдиница/
// СтруктурнаяЕдиницаПолучатель (розничные конфигурации) или Склад/
// СкладОрдер (если склад-получатель не хранится отдельным реквизитом).
&НаСервере
Процедура СоздатьПеремещениеТоваров(Данные)
	Документ = Документы.ПеремещениеЗапасов.СоздатьДокумент();
	Документ.Дата = ТекущаяДата();
	Документ.Комментарий = Данные.comment;
	Документ.СкладОтправитель = НайтиСкладПоИмени(Данные.from_warehouse);
	Документ.СкладПолучатель = НайтиСкладПоИмени(Данные.to_warehouse);
	// TODO: если организаций несколько — выбрать нужную явно.
	Документ.Организация = Справочники.Организации.НайтиПоРеквизиту("ИспользуетсяПоУмолчанию", Истина);

	Для Каждого Строка Из Данные.lines Цикл
		Товар = НайтиТоварПоШтрихкоду(Строка.barcode);
		Если Товар = Неопределено Тогда
			ВызватьИсключение "Не найден товар по штрихкоду " + Строка.barcode;
		КонецЕсли;
		НоваяСтрока = Документ.Товары.Добавить();
		НоваяСтрока.Номенклатура = Товар;
		НоваяСтрока.Количество = Строка.qty;
	КонецЦикла;

	// Сознательно не проводим — только записываем черновиком.
	Документ.Записать(РежимЗаписиДокумента.Запись);
КонецПроцедуры

&НаСервере
Процедура СоздатьИнвентаризациюТоваров(Данные)
	Документ = Документы.ИнвентаризацияЗапасов.СоздатьДокумент();
	Документ.Дата = ТекущаяДата();
	Документ.Комментарий = Данные.comment;
	Документ.Склад = НайтиСкладПоИмени(Данные.warehouse);
	Документ.Организация = Справочники.Организации.НайтиПоРеквизиту("ИспользуетсяПоУмолчанию", Истина);

	Для Каждого Строка Из Данные.lines Цикл
		Товар = НайтиТоварПоШтрихкоду(Строка.barcode);
		Если Товар = Неопределено Тогда
			ВызватьИсключение "Не найден товар по штрихкоду " + Строка.barcode;
		КонецЕсли;
		НоваяСтрока = Документ.Товары.Добавить();
		НоваяСтрока.Номенклатура = Товар;
		НоваяСтрока.Количество = Строка.qty;
	КонецЦикла;

	Документ.Записать(РежимЗаписиДокумента.Запись);
КонецПроцедуры
