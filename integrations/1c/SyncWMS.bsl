КонецПроцедуры

&НаСервере
Функция НайтиОрганизациюПоУмолчанию()

	Организация =
		Справочники.Организации.НайтиПоНаименованию(
			"ТОР-ФАРМ ООО",
			Истина);

	Если Организация.Пустая() Тогда
		ВызватьИсключение
			"Не найдена организация ""ТОР-ФАРМ ООО"".";
	КонецЕсли;

	Возврат Организация;

КонецФункции

&НаСервере
Процедура УстановитьОрганизациюЕслиЕсть(
	Документ)

	// Не трогаем, если уже заполнена — например, документ создан "на
	// основании" (см. СоздатьВозвратПоставщику/Заполнить()) и организация
	// уже определена самой конфигурацией из основания.
	Если Документ.Метаданные().Реквизиты.Найти(
			"Организация") <> Неопределено
		И Не ЗначениеЗаполнено(
			Документ.Организация) Тогда

		Документ.Организация =
			НайтиОрганизациюПоУмолчанию();
	КонецЕсли;

КонецПроцедуры

// Валюта документа — при программном создании (не "на основании") 1С не
// подтягивает ее сама, как и Договор (см. СоздатьВозвратПоставщику), а
// без нее часть баз 1С:УНФ не дает провести расходный документ (см. чат
// — непроводимые возвраты поставщику из-за пустого поля "Валюта
// документа"). Порядок поиска: поступление → организация документа →
// российский рубль как последний запасной вариант.
&НаСервере
Процедура УстановитьВалютуЕслиЕсть(
	Документ,
	Поступление,
	Диагностика)

	Если Документ.Метаданные().Реквизиты.Найти(
		"Валюта") = Неопределено Тогда

		Диагностика.Добавить(
			"ПРЕДУПРЕЖДЕНИЕ: у документа нет реквизита с именем ""Валюта"" "
			+ "— поле ""Валюта документа"" в форме называется в метаданных "
			+ "как-то иначе. Полный список реквизитов документа ниже — "
			+ "найдите там подходящее имя и сообщите его, чтобы поправить "
			+ "код обработки.");

		ОписатьРеквизитыДокумента(
			Документ.Метаданные(),
			Диагностика);

		Возврат;
	КонецЕсли;

	// Уже заполнена — например, документ создан "на основании" (см.
	// Заполнить() в СоздатьВозвратПоставщику) и валюту уже определила сама
	// конфигурация. Не перезаписываем правильное значение своим поиском.
	Если ЗначениеЗаполнено(
			Документ.Валюта) Тогда

		Возврат;
	КонецЕсли;

	Если Поступление <> Неопределено Тогда

		Попытка

			Если Поступление.Метаданные().Реквизиты.Найти(
				"Валюта") <> Неопределено Тогда

				ВалютаПоступления =
					Поступление.Валюта;

				Если ЗначениеЗаполнено(
						ВалютаПоступления) Тогда

					Документ.Валюта =
						ВалютаПоступления;

					Диагностика.Добавить(
						"Валюта документа определена из поступления "
						+ Строка(Поступление) + ": "
						+ Строка(ВалютаПоступления));

					Возврат;
				КонецЕсли;

			КонецЕсли;

		Исключение
		КонецПопытки;

	КонецЕсли;

	Если ЗначениеЗаполнено(
			Документ.Организация) Тогда

		ИменаВалютыОрганизации = Новый Массив;
		ИменаВалютыОрганизации.Добавить("ВалютаУчета");
		ИменаВалютыОрганизации.Добавить("ОсновнаяВалюта");
		ИменаВалютыОрганизации.Добавить("Валюта");

		Для Каждого ИмяРеквизита Из ИменаВалютыОрганизации Цикл

			Если Документ.Организация.Метаданные().Реквизиты.Найти(
				ИмяРеквизита) <> Неопределено Тогда

				Попытка

					ВалютаОрганизации =
						Документ.Организация[ИмяРеквизита];

					Если ЗначениеЗаполнено(
							ВалютаОрганизации) Тогда

						Документ.Валюта =
							ВалютаОрганизации;

						Диагностика.Добавить(
							"Валюта документа определена из организации ("
							+ ИмяРеквизита + "): "
							+ Строка(ВалютаОрганизации));

						Возврат;
					КонецЕсли;

				Исключение
				КонецПопытки;

			КонецЕсли;

		КонецЦикла;

	КонецЕсли;

	Попытка

		РубльПоУмолчанию =
			Справочники.Валюты.НайтиПоКоду(
				"643");

		Если ЗначениеЗаполнено(
				РубльПоУмолчанию) Тогда

			Документ.Валюта =
				РубльПоУмолчанию;

			Диагностика.Добавить(
				"Валюта документа не найдена ни в поступлении, ни в "
				+ "организации — подставлен российский рубль по "
				+ "умолчанию (код ОКВ 643), проверьте перед проведением.");
		КонецЕсли;

	Исключение

		Диагностика.Добавить(
			"ПРЕДУПРЕЖДЕНИЕ: не удалось определить валюту документа "
			+ "автоматически — заполните вручную перед проведением.");

	КонецПопытки;

КонецПроцедуры

// Система налогообложения — как и Валюта выше, при программном создании
// документа 1С не подтягивает ее сама из организации (см. чат —
// непроводимые возвраты поставщику из-за пустого поля "Налогообложение").
&НаСервере
Процедура УстановитьНалогообложениеЕслиЕсть(
	Документ,
	Диагностика)

	ИменаРеквизитаДокумента = Новый Массив;
	ИменаРеквизитаДокумента.Добавить("Налогообложение");
	ИменаРеквизитаДокумента.Добавить("СистемаНалогообложения");

	ИмяРеквизитаДокумента =
		Неопределено;

	Для Каждого Имя Из ИменаРеквизитаДокумента Цикл

		Если Документ.Метаданные().Реквизиты.Найти(
			Имя) <> Неопределено Тогда

			ИмяРеквизитаДокумента =
				Имя;

			Прервать;
		КонецЕсли;

	КонецЦикла;

	Если ИмяРеквизитаДокумента = Неопределено Тогда

		Диагностика.Добавить(
			"ПРЕДУПРЕЖДЕНИЕ: у документа нет реквизита с именем "
			+ """Налогообложение"" или ""СистемаНалогообложения"" — поле "
			+ """Налогообложение"" в форме называется в метаданных как-то "
			+ "иначе. Полный список реквизитов документа ниже — найдите "
			+ "там подходящее имя и сообщите его, чтобы поправить код "
			+ "обработки.");

		ОписатьРеквизитыДокумента(
			Документ.Метаданные(),
			Диагностика);

		Возврат;
	КонецЕсли;

	// Уже заполнено — например, документ создан "на основании" (см.
	// Заполнить() в СоздатьВозвратПоставщику) и налогообложение уже
	// определила сама конфигурация. Не перезаписываем.
	Если ЗначениеЗаполнено(
			Документ[ИмяРеквизитаДокумента]) Тогда

		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(
			Документ.Организация) Тогда

		Возврат;
	КонецЕсли;

	ИменаРеквизитаОрганизации = Новый Массив;
	ИменаРеквизитаОрганизации.Добавить("СистемаНалогообложения");
	ИменаРеквизитаОрганизации.Добавить("Налогообложение");

	Для Каждого ИмяРеквизита Из ИменаРеквизитаОрганизации Цикл

		Если Документ.Организация.Метаданные().Реквизиты.Найти(
			ИмяРеквизита) <> Неопределено Тогда

			Попытка

				НалогообложениеОрганизации =
					Документ.Организация[ИмяРеквизита];

				Если ЗначениеЗаполнено(
						НалогообложениеОрганизации) Тогда

					Документ[ИмяРеквизитаДокумента] =
						НалогообложениеОрганизации;

					Диагностика.Добавить(
						"Налогообложение документа определено из "
						+ "организации (" + ИмяРеквизита + "): "
						+ Строка(НалогообложениеОрганизации));

					Возврат;
				КонецЕсли;

			Исключение
			КонецПопытки;

		КонецЕсли;

	КонецЦикла;

	Диагностика.Добавить(
		"ПРЕДУПРЕЖДЕНИЕ: не удалось определить налогообложение "
		+ "документа — в карточке организации не заполнена система "
		+ "налогообложения. Заполните ее в НСИ и администрирование → "
		+ "Организации, тогда следующие документы заполнятся сами; "
		+ "этот придется поправить вручную.");

КонецПроцедуры

// Переключатель "УПД" в шапке документа (использовать универсальный
// передаточный документ вместо отдельных накладной и счета-фактуры) — для
// возврата поставщику не нужен (см. чат), выключаем его явно. Если
// документ создан "на основании" поступления (см. Заполнить() в
// СоздатьВозвратПоставщику), состояние переключателя могло скопироваться
// оттуда — поэтому выключаем безусловно, а не только когда он включен.
&НаСервере
Процедура ВыключитьУПДЕслиЕсть(
	Документ,
	Диагностика)

	ИменаУПД = Новый Массив;
	ИменаУПД.Добавить("ИспользоватьУПД");
	ИменаУПД.Добавить("УПД");
	ИменаУПД.Добавить("ФормироватьУПД");
	ИменаУПД.Добавить("ОформитьУПД");
	ИменаУПД.Добавить("ПередатьЭДО");
	ИменаУПД.Добавить("ЭДОУПД");

	ИмяРеквизитаУПД =
		Неопределено;

	Для Каждого Имя Из ИменаУПД Цикл

		Если Документ.Метаданные().Реквизиты.Найти(
			Имя) <> Неопределено Тогда

			ИмяРеквизитаУПД =
				Имя;

			Прервать;
		КонецЕсли;

	КонецЦикла;

	Если ИмяРеквизитаУПД = Неопределено Тогда

		Диагностика.Добавить(
			"ПРЕДУПРЕЖДЕНИЕ: у документа нет реквизита переключателя "
			+ """УПД"" ни под одним из проверенных имен ("
			+ СтрСоединить(ИменаУПД, ", ")
			+ ") — выключить его автоматически не удалось, отключите "
			+ "вручную. Полный список реквизитов документа ниже — найдите "
			+ "там подходящее имя и сообщите его, чтобы поправить код "
			+ "обработки.");

		ОписатьРеквизитыДокумента(
			Документ.Метаданные(),
			Диагностика);

		Возврат;
	КонецЕсли;

	Попытка

		Документ[ИмяРеквизитаУПД] =
			Ложь;

		Диагностика.Добавить(
			"Переключатель ""УПД"" выключен (реквизит "
			+ ИмяРеквизитаУПД + ").");

	Исключение

		Диагностика.Добавить(
			"ПРЕДУПРЕЖДЕНИЕ: не удалось выключить ""УПД"" (реквизит "
			+ ИмяРеквизитаУПД + "): " + ОписаниеОшибки());

	КонецПопытки;

КонецПроцедуры

// ============================================================================
// ТАБЛИЧНАЯ ЧАСТЬ
// ============================================================================

&НаСервере
Функция НайтиТабличнуюЧастьТоваров(
	Документ)

	Имена = Новый Массив;
	Имена.Добавить("Товары");
	Имена.Добавить("Запасы");
	Имена.Добавить("Продукция");
	Имена.Добавить("Материалы");
	Имена.Добавить("Позиции");

	МетаОбъект = Документ.Метаданные();

	Для Каждого Имя Из Имена Цикл

		МетаТЧ =
			МетаОбъект.ТабличныеЧасти.Найти(Имя);

		Если МетаТЧ <> Неопределено Тогда

			Возврат Новый Структура(
				"ТабличнаяЧасть,Метаданные",
				Документ[Имя],
				МетаТЧ);

		КонецЕсли;

	КонецЦикла;

	ВызватьИсключение
		"В документе """ + МетаОбъект.Синоним
		+ """ не найдена табличная часть товаров.";

КонецФункции

// Ищем именно поле, тип которого содержит
// СправочникСсылка.Номенклатура.
// Простое текстовое поле никогда не будет выбрано.
&НаСервере
Функция НайтиРеквизитНоменклатуры(
	МетаТЧ)

	ТипНоменклатуры =
		Тип("СправочникСсылка.Номенклатура");

	ПредпочтительныеИмена = Новый Массив;
	ПредпочтительныеИмена.Добавить("Номенклатура");
	ПредпочтительныеИмена.Добавить("Товар");
	ПредпочтительныеИмена.Добавить("Продукция");

	Для Каждого Имя Из ПредпочтительныеИмена Цикл

		Рекв = МетаТЧ.Реквизиты.Найти(Имя);

		Если Рекв <> Неопределено
			И Рекв.Тип.СодержитТип(
				ТипНоменклатуры) Тогда

			Возврат Имя;
		КонецЕсли;

	КонецЦикла;

	Для Каждого Рекв Из МетаТЧ.Реквизиты Цикл

		Если Рекв.Тип.СодержитТип(
			ТипНоменклатуры) Тогда

			Возврат Рекв.Имя;
		КонецЕсли;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

&НаСервере
Функция НайтиРеквизитТЧ(
	МетаТЧ,
	Имена)

	// 1. Точное совпадение по имени реквизита.
	Для Каждого Имя Из Имена Цикл

		Если МетаТЧ.Реквизиты.Найти(
			Имя) <> Неопределено Тогда

			Возврат Имя;
		КонецЕсли;

	КонецЦикла;

	// 2. Совпадение по синониму — в конкретной конфигурации внутреннее имя
	// реквизита может отличаться от стандартного (например, "Штрихкод" в
	// приведенном списке не найдется по имени, если реквизит физически
	// называется иначе), а подпись колонки при этом совпадает.
	Для Каждого Рекв Из МетаТЧ.Реквизиты Цикл

		Для Каждого Имя Из Имена Цикл

			Если ВРег(СокрЛП(Рекв.Синоним))
				= ВРег(СокрЛП(Имя)) Тогда

				Возврат Рекв.Имя;
			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

&НаСервере
Функция ПолучитьКоличествоИзСтрокиWMS(
	СтрокаWMS)

	Имена = Новый Массив;
	Имена.Добавить("qty");
	Имена.Добавить("quantity");
	Имена.Добавить("Количество");
	Имена.Добавить("количество");

	Количество =
		ПолучитьПервоеЗаполненноеСвойство(
			СтрокаWMS,
			Имена);

	Если Количество = Неопределено Тогда
		ВызватьИсключение
			"В строке WMS отсутствует количество (qty).";
	КонецЕсли;

	Попытка
		Количество = Число(Количество);
	Исключение
		ВызватьИсключение
			"Некорректное количество WMS: """
			+ Строка(Количество) + """.";
	КонецПопытки;

	Если Количество <= 0 Тогда
		ВызватьИсключение
			"Некорректное количество WMS: "
			+ Строка(Количество);
	КонецЕсли;

	Возврат Количество;

КонецФункции

// Получаем штрихкод, который уже зарегистрирован в 1С у найденной
// номенклатуры. Это контрольная информация.
&НаСервере
Функция ПолучитьШтрихкодНоменклатуры(
	Товар)

	Если Товар = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	// Справочник штрихкодов.
	Если Метаданные.Справочники.Найти(
		"ШтрихкодыНоменклатуры") <> Неопределено Тогда

		Попытка

			Запрос = Новый Запрос;

			Запрос.Текст =
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	Штрихкоды.Штрихкод КАК Штрихкод
				|ИЗ
				|	Справочник.ШтрихкодыНоменклатуры КАК Штрихкоды
				|ГДЕ
				|	Штрихкоды.Владелец = &Номенклатура";

			Запрос.УстановитьПараметр(
				"Номенклатура",
				Товар);

			Выборка =
				Запрос.Выполнить().Выбрать();

			Если Выборка.Следующий() Тогда
				Возврат Строка(
					Выборка.Штрихкод);
			КонецЕсли;

		Исключение
		КонецПопытки;

	КонецЕсли;

	// Регистр.
	Если Метаданные.РегистрыСведений.Найти(
		"ШтрихкодыНоменклатуры") <> Неопределено Тогда

		Попытка

			Запрос = Новый Запрос;

			Запрос.Текст =
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	Штрихкоды.Штрихкод КАК Штрихкод
				|ИЗ
				|	РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
				|ГДЕ
				|	Штрихкоды.Номенклатура = &Номенклатура";

			Запрос.УстановитьПараметр(
				"Номенклатура",
				Товар);

			Выборка =
				Запрос.Выполнить().Выбрать();

			Если Выборка.Следующий() Тогда
				Возврат Строка(
					Выборка.Штрихкод);
			КонецЕсли;

		Исключение
		КонецПопытки;

	КонецЕсли;

	// Реквизит справочника.
	Если Метаданные.Справочники.Номенклатура.Реквизиты.Найти(
		"Штрихкод") <> Неопределено Тогда

		Попытка
			Возврат Строка(
				Товар.Штрихкод);
		Исключение
		КонецПопытки;

	КонецЕсли;

	Возврат "";

КонецФункции

// Поиск реквизита штрихкода в ТЧ по вхождению "штрихкод"/"barcode" в имя —
// в отличие от НайтиРеквизитТЧ (точное имя или синоним из списка), ловит
// любое нестандартное название реквизита, в т.ч. добавленное расширением.
&НаСервере
Функция НайтиРеквизитШтрихкодаТЧ(
	МетаТЧ)

	Для Каждого Рекв Из МетаТЧ.Реквизиты Цикл

		ИмяНиз = НРег(Рекв.Имя);

		Если СтрНайти(ИмяНиз, "штрихкод") > 0
			Или СтрНайти(ИмяНиз, "barcode") > 0 Тогда

			Возврат Рекв.Имя;
		КонецЕсли;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// ============================================================================
// ЗАПОЛНЕНИЕ СТРОКИ
// ============================================================================

&НаСервере
Процедура ДобавитьСтрокуТовара(
	ТЧ,
	Товар,
	Количество,
	ШтрихкодWMS,
	НаименованиеWMS,
	НомерСтроки,
	Диагностика,
	Цена = Неопределено,
	СтавкаНДС = Неопределено)

	ИмяНоменклатуры =
		НайтиРеквизитНоменклатуры(
			ТЧ.Метаданные);

	Если ИмяНоменклатуры = Неопределено Тогда
		ВызватьИсключение
			"В ТЧ """ + ТЧ.Метаданные.Синоним
			+ """ нет реквизита типа "
			+ "СправочникСсылка.Номенклатура.";
	КонецЕсли;

	ИменаКоличества = Новый Массив;
	ИменаКоличества.Добавить("Количество");
	ИменаКоличества.Добавить("Кол");
	ИменаКоличества.Добавить("КоличествоУпаковок");

	ИмяКоличества =
		НайтиРеквизитТЧ(
			ТЧ.Метаданные,
			ИменаКоличества);

	Если ИмяКоличества = Неопределено Тогда
		ВызватьИсключение
			"Не найдена колонка количества в ТЧ """
			+ ТЧ.Метаданные.Синоним + """.";
	КонецЕсли;

	ИмяШтрихкода =
		НайтиРеквизитШтрихкодаТЧ(
			ТЧ.Метаданные);

	ИменаНаименования = Новый Массив;
	ИменаНаименования.Добавить("Наименование");
	ИменаНаименования.Добавить("НаименованиеТовара");
	ИменаНаименования.Добавить("НаименованиеНоменклатуры");

	ИмяНаименованияТЧ =
		НайтиРеквизитТЧ(
			ТЧ.Метаданные,
			ИменаНаименования);

	ИменаЕдиницы = Новый Массив;
	ИменаЕдиницы.Добавить("ЕдиницаИзмерения");
	ИменаЕдиницы.Добавить("Единица");

	ИмяЕдиницы =
		НайтиРеквизитТЧ(
			ТЧ.Метаданные,
			ИменаЕдиницы);

	НоваяСтрока =
		ТЧ.ТабличнаяЧасть.Добавить();

	// 1. Номенклатура — ТОЛЬКО ссылка.
	НоваяСтрока[ИмяНоменклатуры] =
		Товар;

	// 2. Штрихкод — если в ТЧ есть физический реквизит. Если WMS не прислала
	// штрихкод для строки, подстраховываемся уже зарегистрированным в 1С
	// штрихкодом найденного товара.
	ШтрихкодДляЗаписи =
		ШтрихкодWMS;

	Если ПустаяСтрока(
		ШтрихкодДляЗаписи) Тогда

		ШтрихкодДляЗаписи =
			ПолучитьШтрихкодНоменклатуры(
				Товар);
	КонецЕсли;

	Если ИмяШтрихкода = Неопределено Тогда

		Диагностика.Добавить(
			"Строка " + Строка(НомерСтроки)
			+ ": в ТЧ """ + ТЧ.Метаданные.Синоним
			+ """ нет реквизита штрихкода — колонка "
			+ "не заполнена.");

	ИначеЕсли Не ПустаяСтрока(
		ШтрихкодДляЗаписи) Тогда

		Попытка
			НоваяСтрока[ИмяШтрихкода] =
				ШтрихкодДляЗаписи;
		Исключение
			Диагностика.Добавить(
				"Строка " + Строка(НомерСтроки)
				+ ": не удалось записать barcode в ТЧ: "
				+ ОписаниеОшибки());
		КонецПопытки;

	КонецЕсли;

	// 2b. Наименование — чистое имя из WMS. Пишем отдельно от ссылки на
	// Номенклатуру: в справочнике имя товара может быть замусорено (старый
	// некорректный импорт кладет туда "штрихкод/id ..." вместо названия).
	Если ИмяНаименованияТЧ <> Неопределено
		И Не ПустаяСтрока(
			НаименованиеWMS) Тогда

		Попытка
			НоваяСтрока[ИмяНаименованияТЧ] =
				НаименованиеWMS;
		Исключение
			Диагностика.Добавить(
				"Строка " + Строка(НомерСтроки)
				+ ": не удалось записать наименование в ТЧ: "
				+ ОписаниеОшибки());
		КонецПопытки;

	КонецЕсли;

	// 3. Единица измерения.
	Если ИмяЕдиницы <> Неопределено Тогда

		ИменаИсточникаЕдиницы = Новый Массив;
		ИменаИсточникаЕдиницы.Добавить(
			"ЕдиницаХраненияОстатков");
		ИменаИсточникаЕдиницы.Добавить(
			"ЕдиницаИзмерения");
		ИменаИсточникаЕдиницы.Добавить(
			"БазоваяЕдиницаИзмерения");

		Для Каждого ИмяИсточника Из ИменаИсточникаЕдиницы Цикл

			Если Метаданные.Справочники.Номенклатура.Реквизиты.Найти(
				ИмяИсточника) <> Неопределено Тогда

				Попытка
					НоваяСтрока[ИмяЕдиницы] =
						Товар[ИмяИсточника];

					Прервать;
				Исключение
				КонецПопытки;

			КонецЕсли;

		КонецЦикла;

	КонецЕсли;

	// 4. Количество.
	НоваяСтрока[ИмяКоличества] =
		Количество;

	// 4a. "Из резерва" — сколько из количества строки взято из резерва под
	// заказ покупателя. У возврата поставщику (как и у перемещения/
	// инвентаризации) резерва в принципе нет — если оставить реквизит
	// незаполненным (не 0, а именно "не указано"), часть баз 1С:УНФ не
	// дает провести документ: система не может разложить количество на
	// "из резерва"/"свободное". Явно проставляем 0 — это не догадка, а
	// факт: возврат поставщику ничей резерв не исполняет.
	ИменаИзРезерва = Новый Массив;
	ИменаИзРезерва.Добавить("ИзРезерва");
	ИменаИзРезерва.Добавить("КоличествоИзРезерва");

	ИмяИзРезерваТЧ =
		НайтиРеквизитТЧ(
			ТЧ.Метаданные,
			ИменаИзРезерва);

	Если ИмяИзРезерваТЧ <> Неопределено Тогда

		Попытка
			НоваяСтрока[ИмяИзРезерваТЧ] =
				0;
		Исключение
			Диагностика.Добавить(
				"Строка " + Строка(НомерСтроки)
				+ ": не удалось обнулить ""Из резерва"" в ТЧ: "
				+ ОписаниеОшибки());
		КонецПопытки;

	КонецЕсли;

	// 4b. Цена — заполняется, только если ее передали (см.
	// СоздатьВозвратПоставщику: цена берется из приходной накладной,
	// найденной по номеру из файла) и в ТЧ есть подходящий реквизит.
	// Для перемещения Цена не передается — там реквизит не трогаем.
	Если Цена <> Неопределено Тогда

		ИменаЦены = Новый Массив;
		ИменаЦены.Добавить("Цена");
		ИменаЦены.Добавить("ЦенаЗаЕдиницу");

		ИмяЦеныТЧ =
			НайтиРеквизитТЧ(
				ТЧ.Метаданные,
				ИменаЦены);

		Если ИмяЦеныТЧ <> Неопределено Тогда

			Попытка
				НоваяСтрока[ИмяЦеныТЧ] =
					Цена;
			Исключение
				Диагностика.Добавить(
					"Строка " + Строка(НомерСтроки)
					+ ": не удалось записать цену в ТЧ: "
					+ ОписаниеОшибки());
			КонецПопытки;

		КонецЕсли;

	КонецЕсли;

	// 4c. Сумма — при программном добавлении строки (не руками в форме) 1С
	// не всегда сама пересчитывает ее от Цена*Количество; оставшаяся 0 при
	// ненулевой цене тоже может блокировать проведение. Считаем и пишем
	// явно, только если известна цена (иначе просто нечего умножать).
	Если Цена <> Неопределено Тогда

		ИменаСуммы = Новый Массив;
		ИменаСуммы.Добавить("Сумма");

		ИмяСуммыТЧ =
			НайтиРеквизитТЧ(
				ТЧ.Метаданные,
				ИменаСуммы);

		Если ИмяСуммыТЧ <> Неопределено Тогда

			Попытка
				НоваяСтрока[ИмяСуммыТЧ] =
					Цена * Количество;
			Исключение
				Диагностика.Добавить(
					"Строка " + Строка(НомерСтроки)
					+ ": не удалось записать сумму в ТЧ: "
					+ ОписаниеОшибки());
			КонецПопытки;

		КонецЕсли;

	КонецЕсли;

	// 4d. % НДС — как и Цена, в первую очередь из приходной накладной (см.
	// СоздатьВозвратПоставщику), а если там не нашлось — из ставки по
	// умолчанию в карточке самой номенклатуры. Без этого поля часть баз
	// 1С:УНФ не дает провести расходный документ (возврат поставщику,
	// см. чат). Для перемещения/инвентаризации в ТЧ обычно вообще нет
	// такого реквизита — блок тогда просто ничего не делает.
	ИменаСтавкиНДС = Новый Массив;
	ИменаСтавкиНДС.Добавить("%НДС");
	ИменаСтавкиНДС.Добавить("СтавкаНДС");
	ИменаСтавкиНДС.Добавить("НДС");

	ИмяСтавкиНДСТЧ =
		НайтиРеквизитТЧ(
			ТЧ.Метаданные,
			ИменаСтавкиНДС);

	Если ИмяСтавкиНДСТЧ <> Неопределено Тогда

		ЗначениеСтавкиНДС =
			СтавкаНДС;

		Если ЗначениеСтавкиНДС = Неопределено Тогда

			Попытка
				Если Товар.Метаданные().Реквизиты.Найти(
						"СтавкаНДС") <> Неопределено Тогда

					ЗначениеСтавкиНДС =
						Товар.СтавкаНДС;
				КонецЕсли;
			Исключение
			КонецПопытки;

		КонецЕсли;

		Если ЗначениеСтавкиНДС <> Неопределено
			И ЗначениеЗаполнено(
				ЗначениеСтавкиНДС) Тогда

			Попытка
				НоваяСтрока[ИмяСтавкиНДСТЧ] =
					ЗначениеСтавкиНДС;
			Исключение
				Диагностика.Добавить(
					"Строка " + Строка(НомерСтроки)
					+ ": не удалось записать % НДС в ТЧ: "
					+ ОписаниеОшибки());
			КонецПопытки;

		Иначе

			Диагностика.Добавить(
				"ПРЕДУПРЕЖДЕНИЕ: строка " + Строка(НомерСтроки)
				+ " (" + Товар.Наименование + ") — не удалось определить "
				+ "% НДС ни из поступления, ни из карточки номенклатуры; "
				+ "заполните вручную перед проведением.");

		КонецЕсли;

	КонецЕсли;

	// 5. Контроль до записи.
	Если НоваяСтрока[ИмяНоменклатуры] <> Товар Тогда

		ВызватьИсключение
			"Строка " + Строка(НомерСтроки)
			+ ": реквизит Номенклатура не равен "
			+ "найденной ссылке.";

	КонецЕсли;

	Если НоваяСтрока[ИмяКоличества] <> Количество Тогда

		ВызватьИсключение
			"Строка " + Строка(НомерСтроки)
			+ ": количество изменилось ДО записи. WMS="
			+ Строка(Количество)
			+ ", 1С="
			+ Строка(НоваяСтрока[ИмяКоличества]) + ".";

	КонецЕсли;

	ТекстЦены = "";
	Если Цена <> Неопределено Тогда
		ТекстЦены = "; цена=" + Строка(Цена);
	КонецЕсли;

	Диагностика.Добавить(
		"Строка " + Строка(НомерСтроки)
		+ ": Номенклатура="""
		+ Товар.Наименование
		+ """; qty="
		+ Строка(Количество)
		+ "; barcode WMS="""
		+ ШтрихкодWMS
		+ """; записан в ТЧ="""
		+ ШтрихкодДляЗаписи
		+ """"
		+ ТекстЦены
		+ "."
	);

КонецПроцедуры

// ============================================================================
// ПРОВЕРКА ПОСЛЕ ЗАПИСИ
// ============================================================================

// Если модуль объекта 1С при записи изменит Номенклатуру или Количество,
// синхронизация завершится ошибкой и WMS не получит подтверждение.
&НаСервере
Процедура ПроверитьТабличнуюЧастьПослеЗаписи(
	Документ,
	ОжидаемыеСтроки,
	Диагностика)

	ТЧ =
		НайтиТабличнуюЧастьТоваров(
			Документ);

	ИмяНоменклатуры =
		НайтиРеквизитНоменклатуры(
			ТЧ.Метаданные);

	ИменаКоличества = Новый Массив;
	ИменаКоличества.Добавить("Количество");
	ИменаКоличества.Добавить("Кол");
	ИменаКоличества.Добавить("КоличествоУпаковок");

	ИмяКоличества =
		НайтиРеквизитТЧ(
			ТЧ.Метаданные,
			ИменаКоличества);

	Если ТЧ.ТабличнаяЧасть.Количество()
		<> ОжидаемыеСтроки.Количество() Тогда

		ВызватьИсключение
			"После записи количество строк изменилось. Ожидалось "
			+ Строка(ОжидаемыеСтроки.Количество())
			+ ", фактически "
			+ Строка(ТЧ.ТабличнаяЧасть.Количество()) + ".";

	КонецЕсли;

	Для Номер = 0 По ОжидаемыеСтроки.Количество() - 1 Цикл

		Ожидаемая =
			ОжидаемыеСтроки[Номер];

		Факт =
			ТЧ.ТабличнаяЧасть[Номер];

		Если Факт[ИмяНоменклатуры]
			<> Ожидаемая.Номенклатура Тогда

			ВызватьИсключение
				"После записи строка "
				+ Строка(Номер + 1)
				+ ": Номенклатура изменилась. Ожидалось """
				+ Ожидаемая.Номенклатура.Наименование
				+ """.";
		КонецЕсли;

		Если Факт[ИмяКоличества]
			<> Ожидаемая.Количество Тогда

			ВызватьИсключение
				"После записи строка "
				+ Строка(Номер + 1)
				+ ": количество изменилось. WMS="
				+ Строка(Ожидаемая.Количество)
				+ ", 1С="
				+ Строка(Факт[ИмяКоличества]) + ".";
		КонецЕсли;

	КонецЦикла;

	Диагностика.Добавить(
		"Контроль после записи: OK.");

КонецПроцедуры

&НаСервере
Процедура ЗаписатьДиагностику(
	НомерДокумента,
	Диагностика)

	Для Каждого Сообщение Из Диагностика Цикл

		ЗаписьЖурналаРегистрации(
			"ОбменWMS",
			УровеньЖурналаРегистрации.Информация,,,
			"Документ WMS "
			+ НомерДокумента
			+ ": "
			+ Сообщение);

	КонецЦикла;

КонецПроцедуры

// ============================================================================
// СОЗДАНИЕ ПЕРЕМЕЩЕНИЯ
// ============================================================================

&НаСервере
// Возвращает массив текстов предупреждений — по одному на каждую строку
// перемещения, которую не удалось сопоставить с номенклатурой и поэтому
// пропустили (см. ниже) — пустой массив, если сопоставились все строки.
// Раньше одна такая строка валила ВЕСЬ документ целиком (даже на тысячу с
// лишним штук в остальных строках) — теперь документ все равно создается
// по совпавшим строкам, а пропуски видны и в диагностике 1С, и в самой
// WMS (см. movement_warnings в ПодтвердитьПриемWMS и
// integration_1c.export_confirm — там же ставится "!" у перемещения).
Функция СоздатьПеремещениеТоваров(
	Данные)

	НомерWMS =
		ПолучитьСтроковоеСвойство(
			Данные,
			"number");

	Диагностика = Новый Массив;
	ПредупрежденияПропуска = Новый Массив;

	Документ =
		Документы.ПеремещениеЗапасов.СоздатьДокумент();

	Документ.Дата =
		ТекущаяДата();

	Документ.Комментарий =
		ПолучитьСтроковоеСвойство(
			Данные,
			"comment");

	УстановитьСкладОтправителя(
		Документ,
		НайтиСкладПоИмени(
			ПолучитьСтроковоеСвойство(
				Данные,
				"from_warehouse")));

	УстановитьСкладПолучателя(
		Документ,
		НайтиСкладПоИмени(
			ПолучитьСтроковоеСвойство(
				Данные,
				"to_warehouse")));

	УстановитьОрганизациюЕслиЕсть(
		Документ);

	// Вид операции — по умолчанию конструктор документа "Перемещение
	// запасов" может создать его с любой операцией по умолчанию (или без
	// нее вовсе, если у базы такого реквизита нет) — если реквизит есть,
	// явно выставляем именно "Перемещение". Оборачиваем в Попытку: это
	// необязательное улучшение (документ и без него создается корректно),
	// падать из-за него ВЕСЬ перенос перемещения не должен.
	Попытка

		ОперацияПеремещения =
			НайтиРеквизитИЗначениеОперацииПеремещения(
				Документ,
				Диагностика);

		Если ОперацияПеремещения <> Неопределено Тогда
			Документ[ОперацияПеремещения.ИмяРеквизита] =
				ОперацияПеремещения.Значение;
		КонецЕсли;

	Исключение

		Диагностика.Добавить(
			"ПРЕДУПРЕЖДЕНИЕ: не удалось определить вид операции "
			+ """Перемещение"": " + ОписаниеОшибки()
			+ " — документ создается с операцией по умолчанию.");

	КонецПопытки;

	ТЧ =
		НайтиТабличнуюЧастьТоваров(
			Документ);

	ОжидаемыеСтроки =
		Новый Массив;

	Линии =
		ПолучитьСвойствоИлиПустойМассив(
			Данные,
			"lines");

	Если Линии.Количество() = 0 Тогда
		ВызватьИсключение
			"Перемещение " + НомерWMS
			+ " не содержит строк.";
	КонецЕсли;

	НомерСтроки = 0;

	Для Каждого СтрокаWMS Из Линии Цикл

		НомерСтроки =
			НомерСтроки + 1;

		Количество =
			ПолучитьКоличествоИзСтрокиWMS(
				СтрокаWMS);

		ИменаШтрихкода = Новый Массив;
		ИменаШтрихкода.Добавить("barcode");
		ИменаШтрихкода.Добавить("bar_code");
		ИменаШтрихкода.Добавить("штрихкод");
		ИменаШтрихкода.Добавить("Штрихкод");

		Штрихкод =
			ПолучитьПервоеЗаполненноеСвойство(
				СтрокаWMS,
				ИменаШтрихкода);

		Если Штрихкод = Неопределено Тогда
			Штрихкод = "";
		Иначе
			Штрихкод =
				НормализоватьШтрихкод(
					Штрихкод);
		КонецЕсли;

		ИменаНаименования = Новый Массив;
		ИменаНаименования.Добавить("name");
		ИменаНаименования.Добавить("product_name");
		ИменаНаименования.Добавить("nomenclature_name");
		ИменаНаименования.Добавить("nomenclature");
		ИменаНаименования.Добавить("наименование");

		Наименование =
			ПолучитьПервоеЗаполненноеСвойство(
				СтрокаWMS,
				ИменаНаименования);

		Если Наименование = Неопределено Тогда
			НаименованиеWMS = "";
		Иначе
			НаименованиеWMS =
				СокрЛП(
					Строка(Наименование));
		КонецЕсли;

		ДиагностикаСтроки =
			Новый Массив;

		Товар =
			СопоставитьНоменклатуру(
				СтрокаWMS,
				ДиагностикаСтроки);

		Для Каждого Сообщение Из ДиагностикаСтроки Цикл
			Диагностика.Добавить(
				"Строка "
				+ Строка(НомерСтроки)
				+ ": "
				+ Сообщение);
		КонецЦикла;

		Если Товар = Неопределено Тогда

			ТекстПредупреждения =
				"строка " + Строка(НомерСтроки)
				+ " не сопоставлена с номенклатурой (barcode="""
				+ Штрихкод
				+ """; name="""
				+ НаименованиеWMS
				+ """) — пропущена, остальные строки перемещения "
				+ НомерWMS + " создаются как обычно";

			ПредупрежденияПропуска.Добавить(
				ТекстПредупреждения);

			Диагностика.Добавить(
				"ПРЕДУПРЕЖДЕНИЕ: " + ТекстПредупреждения);

			Продолжить;
		КонецЕсли;

		ДобавитьСтрокуТовара(
			ТЧ,
			Товар,
			Количество,
			Штрихкод,
			НаименованиеWMS,
			НомерСтроки,
			Диагностика);

		Ожидаемые =
			Новый Структура(
				"Номенклатура,Количество,Штрихкод",
				Товар,
				Количество,
				Штрихкод);

		ОжидаемыеСтроки.Добавить(
			Ожидаемые);

	КонецЦикла;

	Если ТЧ.Количество() = 0 Тогда
		// Ни одна строка не сопоставилась — создавать пустой документ
		// перемещения смысла нет, это все еще настоящая ошибка (не путать
		// с частичным пропуском выше, когда сопоставилась хотя бы одна
		// строка). Диагностику по всем попыткам сопоставления пишем в
		// журнал перед тем, как бросить исключение — иначе она потеряется.
		ЗаписатьДиагностику(
			НомерWMS,
			Диагностика);

		ВызватьИсключение
			"Ни одна строка перемещения " + НомерWMS
			+ " не сопоставлена с номенклатурой — документ не создан.";
	КонецЕсли;

	// Документ остается непроведенным.
	Документ.Записать(
		РежимЗаписиДокумента.Запись);

	// Проверяем фактический результат записи.
	ПроверитьТабличнуюЧастьПослеЗаписи(
		Документ,
		ОжидаемыеСтроки,
		Диагностика);

	ЗаписатьДиагностику(
		НомерWMS,
		Диагностика);

	Возврат ПредупрежденияПропуска;

КонецФункции

// ============================================================================
// СОЗДАНИЕ ИНВЕНТАРИЗАЦИИ
// ============================================================================

&НаСервере
Процедура СоздатьИнвентаризациюТоваров(
	Данные)

	НомерWMS =
		ПолучитьСтроковоеСвойство(
			Данные,
			"number");

	Диагностика = Новый Массив;

	Документ =
		Документы.ИнвентаризацияЗапасов.СоздатьДокумент();

	Документ.Дата =
		ТекущаяДата();

	Документ.Комментарий =
		ПолучитьСтроковоеСвойство(
			Данные,
			"comment");

	Имена = Новый Массив;
	Имена.Добавить("Склад");
	Имена.Добавить("СтруктурнаяЕдиница");
	Имена.Добавить("Помещение");

	УстановитьРеквизитСклада(
		Документ,
		Имена,
		НайтиСкладПоИмени(
			ПолучитьСтроковоеСвойство(
				Данные,
				"warehouse")),
		"склад");

	УстановитьОрганизациюЕслиЕсть(
		Документ);

	ТЧ =
		НайтиТабличнуюЧастьТоваров(
			Документ);

	ОжидаемыеСтроки =
		Новый Массив;

	Линии =
		ПолучитьСвойствоИлиПустойМассив(
			Данные,
			"lines");

	Если Линии.Количество() = 0 Тогда
		ВызватьИсключение
			"Инвентаризация "
			+ НомерWMS
			+ " не содержит строк.";
	КонецЕсли;

	НомерСтроки = 0;

	Для Каждого СтрокаWMS Из Линии Цикл

		НомерСтроки =
			НомерСтроки + 1;

		Количество =
			ПолучитьКоличествоИзСтрокиWMS(
				СтрокаWMS);

		ИменаШтрихкода = Новый Массив;
		ИменаШтрихкода.Добавить("barcode");
		ИменаШтрихкода.Добавить("bar_code");
		ИменаШтрихкода.Добавить("штрихкод");
		ИменаШтрихкода.Добавить("Штрихкод");

		Штрихкод =
			ПолучитьПервоеЗаполненноеСвойство(
				СтрокаWMS,
				ИменаШтрихкода);

		Если Штрихкод = Неопределено Тогда
			Штрихкод = "";
		Иначе
			Штрихкод =
				НормализоватьШтрихкод(
					Штрихкод);
		КонецЕсли;

		ИменаНаименования = Новый Массив;
		ИменаНаименования.Добавить("name");
		ИменаНаименования.Добавить("product_name");
		ИменаНаименования.Добавить("nomenclature_name");
		ИменаНаименования.Добавить("nomenclature");
		ИменаНаименования.Добавить("наименование");

		Наименование =
			ПолучитьПервоеЗаполненноеСвойство(
				СтрокаWMS,
				ИменаНаименования);

		Если Наименование = Неопределено Тогда
			НаименованиеWMS = "";
		Иначе
			НаименованиеWMS =
				СокрЛП(
					Строка(Наименование));
		КонецЕсли;

		ДиагностикаСтроки =
			Новый Массив;

		Товар =
			СопоставитьНоменклатуру(
				СтрокаWMS,
				ДиагностикаСтроки);

		Для Каждого Сообщение Из ДиагностикаСтроки Цикл
			Диагностика.Добавить(
				"Строка "
				+ Строка(НомерСтроки)
				+ ": "
				+ Сообщение);
		КонецЦикла;

		Если Товар = Неопределено Тогда

			ВызватьИсключение
				"Не удалось сопоставить строку "
				+ Строка(НомерСтроки)
				+ " инвентаризации "
				+ НомерWMS
				+ ". barcode="""
				+ Штрихкод
				+ """; name="""
				+ НаименованиеWMS
				+ """.";
		КонецЕсли;

		ДобавитьСтрокуТовара(
			ТЧ,
			Товар,
			Количество,
			Штрихкод,
			НаименованиеWMS,
			НомерСтроки,
			Диагностика);

		Ожидаемые =
			Новый Структура(
				"Номенклатура,Количество,Штрихкод",
				Товар,
				Количество,
				Штрихкод);

		ОжидаемыеСтроки.Добавить(
			Ожидаемые);

	КонецЦикла;

	Документ.Записать(
		РежимЗаписиДокумента.Запись);

	ПроверитьТабличнуюЧастьПослеЗаписи(
		Документ,
		ОжидаемыеСтроки,
		Диагностика);

	ЗаписатьДиагностику(
		НомерWMS,
		Диагностика);

КонецПроцедуры

// ============================================================================
// ВОЗВРАТ ПОСТАВЩИКУ (по разбраковке приемки в WMS)
// ============================================================================

&НаСервере
Функция НайтиИмяДокументаПоступления()

	Имена = Новый Массив;
	Имена.Добавить("ПоступлениеТоваровУслуг");
	Имена.Добавить("Поступление");
	Имена.Добавить("ПоступлениеТоваров");
	Имена.Добавить("ПриходнаяНакладная");

	Для Каждого Имя Из Имена Цикл

		Если Метаданные.Документы.Найти(
			Имя) <> Неопределено Тогда

			Возврат Имя;
		КонецЕсли;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Ищет у документа Поступления реквизит "входящего номера" — того, что
// печатает ПОСТАВЩИК на своей накладной (на форме подписан как "Вх.
// номер") — в отличие от "Номер", который 1С присваивает сама и обычно с
// префиксом серии (например "НФНФ-001892"). Именно входящий номер
// вносится в WMS при загрузке файла накладной (см. ReceivingDocument.
// number на стороне WMS) — сравнение с "Номер" почти никогда не совпадет.
&НаСервере
Функция НайтиИмяРеквизитаВходящегоНомера(
	МетаДокумента)

	Имена = Новый Массив;
	Имена.Добавить("ВходящийНомер");
	Имена.Добавить("НомерВходящегоДокумента");
	Имена.Добавить("НомерВх");
	Имена.Добавить("НомерДокументаКонтрагента");

	Для Каждого Имя Из Имена Цикл
		Если МетаДокумента.Реквизиты.Найти(Имя) <> Неопределено Тогда
			Возврат Имя;
		КонецЕсли;
	КонецЦикла;

	// Подпись поля на форме ("Вх. номер") может не совпадать с внутренним
	// именем реквизита ни в одном из вариантов выше — доп. поиск по
	// синониму среди всех реквизитов документа.
	Для Каждого Рекв Из МетаДокумента.Реквизиты Цикл

		Синоним = ВРег(Рекв.Синоним);

		Если СтрНайти(Синоним, "ВХ. НОМЕР") > 0
			Или СтрНайти(Синоним, "ВХОДЯЩИЙ НОМЕР") > 0 Тогда

			Возврат Рекв.Имя;
		КонецЕсли;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Ищем документ Поступления по номеру. Сначала — по входящему номеру (см.
// НайтиИмяРеквизитаВходящегоНомера, "Вх. номер" на форме) — это
// работает надежно, когда номер приемки в WMS является настоящим номером
// накладной поставщика (см. ReceivingDocument.is_from_invoice_import на
// стороне WMS). Не нашли реквизит входящего номера или по нему не
// нашлось документа — пробуем как запасной вариант "Номер" (внутренний
// номер 1С) — на случай баз, где в WMS вносится именно он. Не нашли
// совсем — возвращаем Неопределено, вызывающая сторона создает возврат
// без основания/цен и пишет предупреждение в диагностику.
&НаСервере
Функция НайтиПоступлениеПоНомеру(
	НомерНакладной)

	Если ПустаяСтрока(НомерНакладной) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИмяДокумента =
		НайтиИмяДокументаПоступления();

	Если ИмяДокумента = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	МетаДокумента =
		Метаданные.Документы[ИмяДокумента];

	ИмяВходящегоНомера =
		НайтиИмяРеквизитаВходящегоНомера(
			МетаДокумента);

	Если ИмяВходящегоНомера <> Неопределено Тогда

		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Поступление.Ссылка КАК Ссылка
			|ИЗ
			|	Документ." + ИмяДокумента + " КАК Поступление
			|ГДЕ
			|	Поступление." + ИмяВходящегоНомера + " = &Номер";

		Запрос.УстановитьПараметр(
			"Номер",
			НомерНакладной);

		Выборка =
			Запрос.Выполнить().Выбрать();

		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;

	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Поступление.Ссылка КАК Ссылка
		|ИЗ
		|	Документ." + ИмяДокумента + " КАК Поступление
		|ГДЕ
		|	Поступление.Номер = &Номер";

	Запрос.УстановитьПараметр(
		"Номер",
		НомерНакладной);

	Выборка =
		Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	// Третий вариант — реквизит входящего номера часто вообще не заполняют
	// (см. пример "1912": поле "Вх. номер" пустое), а "Номер" 1С генерирует
	// с префиксом серии и ведущими нулями ("НФНФ-001912" для входящего
	// номера "1912"). Берем документы, чей номер ОКАНЧИВАЕТСЯ на нужные
	// цифры (ПОДОБНО — SQL-запрос это умеет, а точное сравнение хвоста без
	// префикса/нулей — нет), и уже в коде сверяем цифровой хвост без
	// ведущих нулей, чтобы короткий номер вроде "12" не спутать с "112".
	ИскомыйНомер = ЦифровойХвостНомера(НомерНакладной);

	Если ПустаяСтрока(ИскомыйНомер) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Поступление.Ссылка КАК Ссылка,
		|	Поступление.Номер КАК Номер
		|ИЗ
		|	Документ." + ИмяДокумента + " КАК Поступление
		|ГДЕ
		|	Поступление.Номер ПОДОБНО &Маска";

	Запрос.УстановитьПараметр(
		"Маска",
		"%" + ИскомыйНомер);

	Выборка =
		Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Если ЦифровойХвостНомера(Выборка.Номер) = ИскомыйНомер Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Возвращает цифровой хвост строки-номера без ведущих нулей — например
// "НФНФ-001912" даст "1912", а "1912" даст "1912". Используется, чтобы
// сопоставить внутренний номер 1С (с префиксом серии и нулями) с чистым
// входящим номером накладной поставщика, который передает WMS.
&НаСервере
Функция ЦифровойХвостНомера(
	Номер)

	Хвост = "";
	Инд = СтрДлина(Номер);

	Пока Инд >= 1 Цикл
		Символ = Сред(Номер, Инд, 1);
		Если Символ >= "0" И Символ <= "9" Тогда
			Хвост = Символ + Хвост;
		Иначе
			Прервать;
		КонецЕсли;
		Инд = Инд - 1;
	КонецЦикла;

	Пока СтрДлина(Хвост) > 1 И Лев(Хвост, 1) = "0" Цикл
		Хвост = Сред(Хвост, 2);
	КонецЦикла;

	Возврат Хвост;

КонецФункции

// Цены для возврата поставщику берутся из приходной накладной (см.
// НайтиПоступлениеПоНомеру — находит ее по номеру из файла накладной,
// который WMS передает как invoice_number), а не из заказа поставщику: в
// заказе может быть плановая цена, в поступлении — фактическая закупочная,
// именно по ней и оформляется возврат. Ключ соответствия — ссылка на
// Номенклатуру (та же, что уже сопоставлена для строки возврата), поэтому
// сопоставление устойчиво к тому, что название/штрихкод в поступлении и в
// WMS записаны по-разному. Не нашли поступление или в нем нет реквизита
// цены — возвращаем пустое соответствие, возврат создается без цен, как и
// раньше (бухгалтер проставит вручную).
&НаСервере
Функция НайтиЦеныПоступленияПоНоменклатуре(
	Поступление,
	Диагностика)

	ЦеныПоНоменклатуре = Новый Соответствие;

	Если Поступление = Неопределено Тогда
		Возврат ЦеныПоНоменклатуре;
	КонецЕсли;

	Попытка

		ТЧ =
			НайтиТабличнуюЧастьТоваров(
				Поступление);

		ИмяНоменклатуры =
			НайтиРеквизитНоменклатуры(
				ТЧ.Метаданные);

		Если ИмяНоменклатуры = Неопределено Тогда
			Диагностика.Добавить(
				"ПРЕДУПРЕЖДЕНИЕ: в поступлении " + Строка(Поступление)
				+ " не нашелся реквизит номенклатуры — цены для возврата "
				+ "не подставлены.");
			Возврат ЦеныПоНоменклатуре;
		КонецЕсли;

		ИменаЦены = Новый Массив;
		ИменаЦены.Добавить("Цена");
		ИменаЦены.Добавить("ЦенаЗаЕдиницу");

		ИмяЦены =
			НайтиРеквизитТЧ(
				ТЧ.Метаданные,
				ИменаЦены);

		Если ИмяЦены = Неопределено Тогда
			Диагностика.Добавить(
				"ПРЕДУПРЕЖДЕНИЕ: в поступлении " + Строка(Поступление)
				+ " не нашлось реквизита цены (проверены: "
				+ СтрСоединить(ИменаЦены, ", ")
				+ ") — цены для возврата не подставлены.");
			Возврат ЦеныПоНоменклатуре;
		КонецЕсли;

		Для Каждого Строка Из ТЧ.ТабличнаяЧасть Цикл

			ЦеныПоНоменклатуре.Вставить(
				Строка[ИмяНоменклатуры],
				Строка[ИмяЦены]);

		КонецЦикла;

		Диагностика.Добавить(
			"Цены получены из поступления " + Строка(Поступление)
			+ ": строк с ценой — "
			+ Строка(ЦеныПоНоменклатуре.Количество()) + ".");

	Исключение

		Диагностика.Добавить(
			"ПРЕДУПРЕЖДЕНИЕ: не удалось получить цены из поступления "
			+ Строка(Поступление) + ": " + ОписаниеОшибки()
			+ " — цены для возврата не подставлены.");

	КонецПопытки;

	Возврат ЦеныПоНоменклатуре;

КонецФункции

// Ставки НДС по строкам приходной накладной — той же логики, что и цены
// выше (НайтиЦеныПоступленияПоНоменклатуре): без "% НДС" часть баз 1С:УНФ
// не дает провести расходный документ (см. чат — непроводимые возвраты
// поставщику из-за пустой колонки "% НДС"). Не нашли в поступлении —
// ДобавитьСтрокуТовара подставит ставку из карточки номенклатуры сама.
&НаСервере
Функция НайтиНДСПоступленияПоНоменклатуре(
	Поступление,
	Диагностика)

	НДСПоНоменклатуре = Новый Соответствие;

	Если Поступление = Неопределено Тогда
		Возврат НДСПоНоменклатуре;
	КонецЕсли;

	Попытка

		ТЧ =
			НайтиТабличнуюЧастьТоваров(
				Поступление);

		ИмяНоменклатуры =
			НайтиРеквизитНоменклатуры(
				ТЧ.Метаданные);

		Если ИмяНоменклатуры = Неопределено Тогда
			Возврат НДСПоНоменклатуре;
		КонецЕсли;

		ИменаСтавкиНДС = Новый Массив;
		ИменаСтавкиНДС.Добавить("%НДС");
		ИменаСтавкиНДС.Добавить("СтавкаНДС");
		ИменаСтавкиНДС.Добавить("НДС");

		ИмяСтавкиНДС =
			НайтиРеквизитТЧ(
				ТЧ.Метаданные,
				ИменаСтавкиНДС);

		Если ИмяСтавкиНДС = Неопределено Тогда
			Возврат НДСПоНоменклатуре;
		КонецЕсли;

		Для Каждого Строка Из ТЧ.ТабличнаяЧасть Цикл

			Если ЗначениеЗаполнено(
					Строка[ИмяСтавкиНДС]) Тогда

				НДСПоНоменклатуре.Вставить(
					Строка[ИмяНоменклатуры],
					Строка[ИмяСтавкиНДС]);
			КонецЕсли;

		КонецЦикла;

		Диагностика.Добавить(
			"Ставки НДС получены из поступления " + Строка(Поступление)
			+ ": строк со ставкой — "
			+ Строка(НДСПоНоменклатуре.Количество()) + ".");

	Исключение

		Диагностика.Добавить(
			"ПРЕДУПРЕЖДЕНИЕ: не удалось получить ставки НДС из поступления "
			+ Строка(Поступление) + ": " + ОписаниеОшибки()
			+ " — % НДС для возврата не подставлен из накладной.");

	КонецПопытки;

	Возврат НДСПоНоменклатуре;

КонецФункции

// Поправляет "Количество" в уже заведенной приходной накладной под то, что
// реально приняли на складе (см. WMS: receiving.confirm_line — пересчет).
// Ищет накладную по номеру (invoice_number — см. НайтиПоступлениеПоНомеру),
// сопоставляет строки по штрихкоду/наименованию (как и остальные документы
// обмена) и переписывает "Количество" под фактическое.
//
// Сначала сверяет количество через ссылку (без ПолучитьОбъект()), НЕ трогая
// документ вообще — если оно и так совпадает с ВМС (например, накладную уже
// поправили вручную), реального расхождения нет и синхронизация считается
// успешной без записи в документ, даже если он уже проведен.
//
// Если расхождение реальное, а накладная уже проведена — НЕ трогает
// проведение документа вообще: корректировка ЭТОЙ функцией не делается
// (падает исключением, документ остается в ошибках синхронизации и будет
// предложен повторно на следующей синхронизации) — отменять проведение,
// чтобы изменить количество, а потом проводить обратно — задача бухгалтера,
// обработка это не автоматизирует.
&НаСервере
Процедура СкорректироватьПриемку(
	Данные)

	НомерНакладной =
		ПолучитьСтроковоеСвойство(
			Данные,
			"invoice_number");

	Диагностика = Новый Массив;

	Попытка

	Поступление =
		НайтиПоступлениеПоНомеру(
			НомерНакладной);

	Если Поступление = Неопределено Тогда
		ВызватьИсключение
			"Не найдена приходная накладная по номеру """
			+ НомерНакладной + """.";
	КонецЕсли;

	// ТЧ читаем через ссылку (без ПолучитьОбъект()) — работает и для уже
	// проведенных документов. Так можно сначала посчитать, есть ли РЕАЛЬНОЕ
	// расхождение с ВМС, и только потом решать, нужно ли вообще трогать
	// документ (см. ниже).
	ТЧ =
		НайтиТабличнуюЧастьТоваров(
			Поступление);

	ИмяНоменклатуры =
		НайтиРеквизитНоменклатуры(
			ТЧ.Метаданные);

	Если ИмяНоменклатуры = Неопределено Тогда
		ВызватьИсключение
			"В ТЧ """ + ТЧ.Метаданные.Синоним
			+ """ нет реквизита номенклатуры.";
	КонецЕсли;

	ИменаКоличества = Новый Массив;
	ИменаКоличества.Добавить("Количество");
	ИменаКоличества.Добавить("Кол");
	ИменаКоличества.Добавить("КоличествоУпаковок");

	ИмяКоличества =
		НайтиРеквизитТЧ(
			ТЧ.Метаданные,
			ИменаКоличества);

	Если ИмяКоличества = Неопределено Тогда
		ВызватьИсключение
			"Не найдена колонка количества в ТЧ """
			+ ТЧ.Метаданные.Синоним + """.";
	КонецЕсли;

	Линии =
		ПолучитьСвойствоИлиПустойМассив(
			Данные,
			"lines");

	// Накладную ранее могли уже поправить вручную (и провести) так, что
	// количество и так совпадает с ВМС — тогда расхождения нет, менять
	// нечего, и факт "уже проведена" вообще не помеха: просто помечаем как
	// синхронизировано, документ не трогаем.
	СтрокиДляИзменения = Новый Массив;

	Для Каждого СтрокаWMS Из Линии Цикл

		ДиагностикаСтроки =
			Новый Массив;

		Товар =
			СопоставитьНоменклатуру(
				СтрокаWMS,
				ДиагностикаСтроки);

		Для Каждого Сообщение Из ДиагностикаСтроки Цикл
			Диагностика.Добавить(
				Сообщение);
		КонецЦикла;

		Если Товар = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		НовоеКоличество =
			ПолучитьКоличествоИзСтрокиWMS(
				СтрокаWMS);

		НайденаСтрока =
			Ложь;

		Для Каждого СтрокаТЧ Из ТЧ.ТабличнаяЧасть Цикл

			Если СтрокаТЧ[ИмяНоменклатуры] = Товар Тогда

				НайденаСтрока = Истина;

				Если СтрокаТЧ[ИмяКоличества] <> НовоеКоличество Тогда
					СтрокиДляИзменения.Добавить(
						Новый Структура(
							"Товар,Количество",
							Товар,
							НовоеКоличество));
				КонецЕсли;

				Прервать;
			КонецЕсли;

		КонецЦикла;

		Если Не НайденаСтрока Тогда
			Диагностика.Добавить(
				"ПРЕДУПРЕЖДЕНИЕ: товар " + Товар.Наименование
				+ " не найден строкой в накладной " + НомерНакладной
				+ " — количество не изменено.");
		КонецЕсли;

	КонецЦикла;

	Если СтрокиДляИзменения.Количество() = 0 Тогда

		Диагностика.Добавить(
			"Накладная " + НомерНакладной
			+ ": количество уже совпадает с ВМС — изменений не требуется.");

		ЗаписатьДиагностику(
			НомерНакладной,
			Диагностика);

		Возврат;

	КонецЕсли;

	Если Поступление.Проведен Тогда
		ВызватьИсключение
			"Накладная " + НомерНакладной
			+ " уже проведена — количество НЕ изменено. Отмените "
			+ "проведение, поправьте количество вручную (или запустите "
			+ "синхронизацию заново после отмены) и проведите обратно.";
	КонецЕсли;

	ОбъектПоступления =
		Поступление.ПолучитьОбъект();

	ТЧОбъекта =
		ОбъектПоступления[ТЧ.Метаданные.Имя];

	Изменено = 0;

	Для Каждого Изменение Из СтрокиДляИзменения Цикл

		Для Каждого СтрокаТЧ Из ТЧОбъекта Цикл

			Если СтрокаТЧ[ИмяНоменклатуры] = Изменение.Товар Тогда

				СтароеКоличество =
					СтрокаТЧ[ИмяКоличества];

				СтрокаТЧ[ИмяКоличества] =
					Изменение.Количество;

				Диагностика.Добавить(
					"Накладная " + НомерНакладной + ", "
					+ Изменение.Товар.Наименование + ": количество "
					+ Строка(СтароеКоличество) + " -> "
					+ Строка(Изменение.Количество));

				Изменено = Изменено + 1;

				Прервать;
			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

	ОбъектПоступления.Записать(
		РежимЗаписиДокумента.Запись);

	Диагностика.Добавить(
		"Накладная " + НомерНакладной
		+ ": скорректировано строк — " + Строка(Изменено) + ".");

	ЗаписатьДиагностику(
		НомерНакладной,
		Диагностика);

	Исключение

		ЗаписатьДиагностику(
			НомерНакладной,
			Диагностика);

		ВызватьИсключение
			ОписаниеОшибки();

	КонецПопытки;

КонецПроцедуры

// ============================================================================
// КОРРЕКТИРОВКА ПЕРЕМЕЩЕНИЯ
// ============================================================================

// Ищем документ "Перемещение запасов" по номеру WMS, зашитому в поле
// "Комментарий" при создании (см. WMS: integration_1c._movement_payload —
// текст вида "WMS: {number} (склад получатель: ...)"). В отличие от
// поступления (НайтиПоступлениеПоНомеру), у перемещения нет отдельного
// реквизита с номером WMS — искать приходится по тексту комментария. Ищем
// подстроку "WMS: " + НомерWMS + " (" — открывающая скобка сразу после
// номера отсекает случайное совпадение, когда один номер WMS является
// префиксом другого (например, "ПЕР-1" не должен найтись по маске номера
// "ПЕР-10"). Если совпадений несколько (не должно случаться — номер WMS
// уникален), берем последний по дате документ.
&НаСервере
Функция НайтиПеремещениеПоНомеруWMS(
	НомерWMS)

	Если ПустаяСтрока(
		НомерWMS) Тогда

		Возврат Неопределено;
	КонецЕсли;

	Если Метаданные.Документы.Найти(
		"ПеремещениеЗапасов") = Неопределено Тогда

		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Перемещение.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПеремещениеЗапасов КАК Перемещение
		|ГДЕ
		|	Перемещение.Комментарий ПОДОБНО &Маска
		|УПОРЯДОЧИТЬ ПО
		|	Перемещение.Дата УБЫВ";

	Запрос.УстановитьПараметр(
		"Маска",
		"%WMS: " + НомерWMS + " (%");

	Выборка =
		Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Пересобирает табличную часть уже созданного документа "Перемещение
// запасов" под ТЕКУЩИЙ состав из WMS — короб добавили/удалили в документе
// (см. movement.add_box/delete_line), либо поправили количество в коробе,
// уже уехавшем этим перемещением (см. boxes.add_item/update_item/
// move_item/delete_item) — ПОСЛЕ того, как документ уже был выгружен в 1С
// (см. MovementDocument.composition_changed_at). Полная пересборка ТЧ (не
// диф по строкам) — так же, как и в СоздатьВозвратПоставщику: проще
// пересобрать целиком под актуальный список, чем сопоставлять построчно,
// какая именно строка изменилась.
//
// Если документ уже проведен — НЕ трогаем его вообще, как и в
// СкорректироватьПриемку: исключение, документ останется в очереди
// коррекции WMS до тех пор, пока бухгалтер не отменит проведение и не
// поправит состав вручную (или не запустит синхронизацию заново после
// отмены проведения).
&НаСервере
Процедура СкорректироватьПеремещение(
	Данные)

	НомерWMS =
		ПолучитьСтроковоеСвойство(
			Данные,
			"number");

	Диагностика = Новый Массив;

	Попытка

	Документ =
		НайтиПеремещениеПоНомеруWMS(
			НомерWMS);

	Если Документ = Неопределено Тогда
		ВызватьИсключение
			"Не найден документ ""Перемещение запасов"" по номеру WMS """
			+ НомерWMS
			+ """ (ищем по тексту ""WMS: "
			+ НомерWMS + " ("" в поле ""Комментарий"").";
	КонецЕсли;

	Если Документ.Проведен Тогда
		ВызватьИсключение
			"Перемещение " + НомерWMS
			+ " (документ 1С " + Строка(Документ) + ") уже проведено — "
			+ "состав НЕ изменен. Отмените проведение, поправьте состав "
			+ "вручную (или запустите синхронизацию заново после отмены) "
			+ "и проведите обратно.";
	КонецЕсли;

	Линии =
		ПолучитьСвойствоИлиПустойМассив(
			Данные,
			"lines");

	Если Линии.Количество() = 0 Тогда
		ВызватьИсключение
			"Перемещение " + НомерWMS
			+ ": в присланных данных нет ни одной строки — похоже на "
			+ "ошибку выгрузки, а не на реально пустой документ, "
			+ "коррекция не выполнена.";
	КонецЕсли;

	ОбъектДокумента =
		Документ.ПолучитьОбъект();

	ТЧ =
		НайтиТабличнуюЧастьТоваров(
			ОбъектДокумента);

	СтарыхСтрок =
		ТЧ.ТабличнаяЧасть.Количество();

	ТЧ.ТабличнаяЧасть.Очистить();

	ОжидаемыеСтроки = Новый Массив;
	ПредупрежденияПропуска = Новый Массив;
	НомерСтроки = 0;

	Для Каждого СтрокаWMS Из Линии Цикл

		НомерСтроки =
			НомерСтроки + 1;

		Количество =
			ПолучитьКоличествоИзСтрокиWMS(
				СтрокаWMS);

		ИменаШтрихкода = Новый Массив;
		ИменаШтрихкода.Добавить("barcode");
		ИменаШтрихкода.Добавить("bar_code");
		ИменаШтрихкода.Добавить("штрихкод");
		ИменаШтрихкода.Добавить("Штрихкод");

		Штрихкод =
			ПолучитьПервоеЗаполненноеСвойство(
				СтрокаWMS,
				ИменаШтрихкода);

		Если Штрихкод = Неопределено Тогда
			Штрихкод = "";
		Иначе
			Штрихкод =
				НормализоватьШтрихкод(
					Штрихкод);
		КонецЕсли;

		ИменаНаименования = Новый Массив;
		ИменаНаименования.Добавить("name");
		ИменаНаименования.Добавить("product_name");
		ИменаНаименования.Добавить("nomenclature_name");
		ИменаНаименования.Добавить("nomenclature");
		ИменаНаименования.Добавить("наименование");

		Наименование =
			ПолучитьПервоеЗаполненноеСвойство(
				СтрокаWMS,
				ИменаНаименования);

		Если Наименование = Неопределено Тогда
			НаименованиеWMS = "";
		Иначе
			НаименованиеWMS =
				СокрЛП(
					Строка(Наименование));
		КонецЕсли;

		ДиагностикаСтроки =
			Новый Массив;

		Товар =
			СопоставитьНоменклатуру(
				СтрокаWMS,
				ДиагностикаСтроки);

		Для Каждого Сообщение Из ДиагностикаСтроки Цикл
			Диагностика.Добавить(
				"Строка " + Строка(НомерСтроки) + ": " + Сообщение);
		КонецЦикла;

		Если Товар = Неопределено Тогда

			ТекстПредупреждения =
				"строка " + Строка(НомерСтроки)
				+ " не сопоставлена с номенклатурой (barcode="""
				+ Штрихкод + """; name=""" + НаименованиеWMS
				+ """) — пропущена при коррекции перемещения "
				+ НомерWMS;

			ПредупрежденияПропуска.Добавить(
				ТекстПредупреждения);

			Диагностика.Добавить(
				"ПРЕДУПРЕЖДЕНИЕ: " + ТекстПредупреждения);

			Продолжить;
		КонецЕсли;

		ДобавитьСтрокуТовара(
			ТЧ,
			Товар,
			Количество,
			Штрихкод,
			НаименованиеWMS,
			НомерСтроки,
			Диагностика);

		ОжидаемыеСтроки.Добавить(
			Новый Структура(
				"Номенклатура,Количество,Штрихкод",
				Товар,
				Количество,
				Штрихкод));

	КонецЦикла;

	Если ТЧ.ТабличнаяЧасть.Количество() = 0 Тогда

		ЗаписатьДиагностику(
			НомерWMS,
			Диагностика);

		ВызватьИсключение
			"Перемещение " + НомерWMS
			+ ": ни одна строка не сопоставлена с номенклатурой — "
			+ "коррекция НЕ выполнена, документ в 1С остается как был.";
	КонецЕсли;

	ОбъектДокумента.Записать(
		РежимЗаписиДокумента.Запись);

	ПроверитьТабличнуюЧастьПослеЗаписи(
		ОбъектДокумента,
		ОжидаемыеСтроки,
		Диагностика);

	ТекстПропусков = "";
	Если ПредупрежденияПропуска.Количество() > 0 Тогда
		ТекстПропусков =
			"; пропущено несопоставленных строк — "
			+ Строка(ПредупрежденияПропуска.Количество());
	КонецЕсли;

	Диагностика.Добавить(
		"Перемещение " + НомерWMS
		+ ": состав пересобран — было строк " + Строка(СтарыхСтрок)
		+ ", стало " + Строка(ТЧ.ТабличнаяЧасть.Количество())
		+ ТекстПропусков + ".");

	ЗаписатьДиагностику(
		НомерWMS,
		Диагностика);

	Исключение

		ЗаписатьДиагностику(
			НомерWMS,
			Диагностика);

		ВызватьИсключение
			ОписаниеОшибки();

	КонецПопытки;

КонецПроцедуры

&НаСервере
Функция НайтиИмяДокументаЗаказаПоставщику()

	Имена = Новый Массив;
	Имена.Добавить("ЗаказПоставщику");
	Имена.Добавить("ЗаказыПоставщикам");
	Имена.Добавить("ЗаказПоставщика");

	Для Каждого Имя Из Имена Цикл

		Если Метаданные.Документы.Найти(
			Имя) <> Неопределено Тогда

			Возврат Имя;
		КонецЕсли;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Ищем "Заказ поставщику" по его номеру (Номер) — основной способ найти
// основание для возврата в 1С:УНФ (см. СоздатьВозвратПоставщику): номер
// заказа вносится в WMS вручную при загрузке накладной (ReceivingDocument.
// order_number, поле "№ заявки" — в файле накладной его нет). Важно: нужен
// именно тот номер, что показан в реквизите "Номер" самого Заказа
// поставщику (например "Ш-00105"), а НЕ короткое число из заголовка формы
// документа ("Заказ поставщику 105 от ...") — заголовок отображает номер
// без префикса, а сравнение здесь идет по фактическому значению реквизита.
// Оставляет только цифры и убирает ведущие нули — чтобы "6", "000000006"
// и "Ш-00006" сравнивались как один и тот же номер независимо от того,
// сколько нулей/букв добавляет нумератор документа. Пустая строка, если
// цифр нет вовсе (тогда сравнивать по номеру бессмысленно).
&НаСервере
Функция ТолькоЦифрыБезВедущихНулей(
	Строка)

	Цифры = "";

	Для Индекс = 1 По СтрДлина(Строка) Цикл

		Символ = Сред(Строка, Индекс, 1);

		Если Символ >= "0" И Символ <= "9" Тогда
			Цифры = Цифры + Символ;
		КонецЕсли;

	КонецЦикла;

	Пока СтрДлина(Цифры) > 1
		И Лев(Цифры, 1) = "0" Цикл

		Цифры = Сред(Цифры, 2);

	КонецЦикла;

	Возврат Цифры;

КонецФункции

// Ищет у документа реквизит-ссылку на контрагента ("Поставщик",
// "Контрагент", "Клиент") — нужен, чтобы не перепутать заказы у разных
// поставщиков с совпадающими "голыми" цифрами номера (см. ниже).
&НаСервере
Функция НайтиИмяРеквизитаКонтрагента(
	МетаОбъект)

	Имена = Новый Массив;
	Имена.Добавить("Поставщик");
	Имена.Добавить("Контрагент");
	Имена.Добавить("Клиент");

	Для Каждого Имя Из Имена Цикл

		Если МетаОбъект.Реквизиты.Найти(
			Имя) <> Неопределено Тогда

			Возврат Имя;
		КонецЕсли;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Сравнение названий поставщика нестрогое (одна строка входит в другую,
// без учета регистра) — организационно-правовая форма ("ИП", "ООО") в
// WMS и 1С может стоять в разном порядке или отсутствовать.
&НаСервере
Функция НазванияПоставщикаСовпадают(
	Первое,
	Второе)

	А = ВРег(СокрЛП(Первое));
	Б = ВРег(СокрЛП(Второе));

	Если ПустаяСтрока(А) Или ПустаяСтрока(Б) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат СтрНайти(А, Б) > 0 Или СтрНайти(Б, А) > 0;

КонецФункции

// ИНН — надежный уникальный идентификатор поставщика (в отличие от
// названия, которое в 1С и в WMS может звучать по-разному — короткий
// внутренний алиас против полного названия из накладной). Молча Ложь,
// если у контрагента нет реквизита ИНН вовсе — не все справочники
// контрагентов его имеют.
&НаСервере
Функция ИННСовпадает(
	Контрагент,
	ИНН)

	Если ПустаяСтрока(ИНН) Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Возврат СокрЛП(Строка(Контрагент.ИНН)) = СокрЛП(ИНН);
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Ищет ссылку на контрагента по точному наименованию — в том справочнике,
// на который реально ссылается реквизит ИмяРеквизита у документа с
// метаданными МетаОбъект (обычно "Контрагенты" или "Партнеры" — имя
// справочника не жестко задаем, а берем из типа самого реквизита).
&НаСервере
Функция НайтиКонтрагентаПоИмени(
	МетаОбъект,
	ИмяРеквизита,
	Имя)

	Если ПустаяСтрока(Имя) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Рекв = МетаОбъект.Реквизиты.Найти(ИмяРеквизита);

	Если Рекв = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого ТекТип Из Рекв.Тип.Типы() Цикл

		МетаСправочника = Метаданные.НайтиПоТипу(ТекТип);

		Если МетаСправочника = Неопределено
			Или Метаданные.Справочники.Найти(МетаСправочника.Имя)
				<> МетаСправочника Тогда

			Продолжить;
		КонецЕсли;

		Попытка
			Найдено =
				Справочники[МетаСправочника.Имя].НайтиПоНаименованию(
					СокрЛП(Имя),
					Истина);

			Если Найдено <> Неопределено
				И Не Найдено.Пустая() Тогда

				Возврат Найдено;
			КонецЕсли;
		Исключение
		КонецПопытки;

		// Точное наименование не нашлось — организационно-правовая форма
		// ("ИП", "ООО") в WMS и 1С может стоять в разном порядке или
		// отсутствовать вовсе. Пробуем неточный поиск по вхождению строки.
		Попытка
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	Контрагент.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник." + МетаСправочника.Имя + " КАК Контрагент
				|ГДЕ
				|	Контрагент.Наименование ПОДОБНО &Маска
				|	И НЕ Контрагент.ПометкаУдаления";

			Запрос.УстановитьПараметр(
				"Маска",
				"%" + СокрЛП(Имя) + "%");

			Выборка =
				Запрос.Выполнить().Выбрать();

			Если Выборка.Следующий() Тогда
				Возврат Выборка.Ссылка;
			КонецЕсли;
		Исключение
			// ПОДОБНО с произвольной строкой может упасть, если в имени
			// встретились спецсимволы шаблона (%, _, #) — не фатально.
		КонецПопытки;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Ищет ссылку на контрагента по ИНН — в том же справочнике, на который
// ссылается ИмяРеквизита. Основной (более надежный, чем по имени) способ
// сопоставить поставщика: "Наименование" в 1С часто внутренний короткий
// алиас, а ИНН — уникальный и совпадает с тем, что в справочнике
// поставщиков WMS (заполняется при загрузке накладной).
&НаСервере
Функция НайтиКонтрагентаПоИНН(
	МетаОбъект,
	ИмяРеквизита,
	ИНН)

	Если ПустаяСтрока(ИНН) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Рекв = МетаОбъект.Реквизиты.Найти(ИмяРеквизита);

	Если Рекв = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого ТекТип Из Рекв.Тип.Типы() Цикл

		МетаСправочника = Метаданные.НайтиПоТипу(ТекТип);

		Если МетаСправочника = Неопределено
			Или Метаданные.Справочники.Найти(МетаСправочника.Имя)
				<> МетаСправочника
			Или МетаСправочника.Реквизиты.Найти("ИНН") = Неопределено Тогда

			Продолжить;
		КонецЕсли;

		Попытка
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	Контрагент.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник." + МетаСправочника.Имя + " КАК Контрагент
				|ГДЕ
				|	Контрагент.ИНН = &ИНН
				|	И НЕ Контрагент.ПометкаУдаления";

			Запрос.УстановитьПараметр(
				"ИНН",
				СокрЛП(ИНН));

			Выборка =
				Запрос.Выполнить().Выбрать();

			Если Выборка.Следующий() Тогда
				Возврат Выборка.Ссылка;
			КонецЕсли;
		Исключение
		КонецПопытки;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Ищем "Заказ поставщику" по его номеру (Номер) — основной способ найти
// основание для возврата в 1С:УНФ (см. СоздатьВозвратПоставщику): номер
// заказа вносится в WMS вручную при загрузке накладной (ReceivingDocument.
// order_number, поле "№ заявки" — в файле накладной его нет).
//
// ВАЖНО: у разных поставщиков "голые" цифры номера могут совпадать
// (например "ВБ-к04" и "ОЗ-к04" — у обоих "4"; "ОЗ-К05", "OZ Ж-005",
// "ШМ-005", "ВБ-К05" — у всех "5") — префикс здесь не декоративный, а
// часть настоящего номера (кодирует площадку/канал). Поэтому нечеткое
// совпадение по цифрам (см. ТолькоЦифрыБезВедущихНулей) применяется
// только вместе с проверкой поставщика — без этого легко привязать
// возврат не к тому заказу.
&НаСервере
Функция НайтиЗаказПоставщикуПоНомеру(
	НомерЗаказа,
	Поставщик,
	ПоставщикИНН)

	Если ПустаяСтрока(НомерЗаказа) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИмяДокумента =
		НайтиИмяДокументаЗаказаПоставщику();

	Если ИмяДокумента = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	МетаОбъект =
		Метаданные.Документы[ИмяДокумента];

	ИмяКонтрагента =
		НайтиИмяРеквизитаКонтрагента(МетаОбъект);

	ПолеКонтрагента = "";
	Если ИмяКонтрагента <> Неопределено Тогда
		ПолеКонтрагента =
			",
			|	Заказ." + ИмяКонтрагента + " КАК Контрагент";
	КонецЕсли;

	// 1. Точное совпадение по номеру — быстрый путь, срабатывает, если в
	// WMS внесли номер ровно как он хранится в реквизите "Номер" (с
	// префиксом площадки и ведущими нулями). Номер здесь достаточно
	// уникален сам по себе (в отличие от "голых" цифр ниже) — поставщика
	// дополнительно не проверяем, доверяем точному совпадению.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Заказ.Ссылка КАК Ссылка
		|ИЗ
		|	Документ." + ИмяДокумента + " КАК Заказ
		|ГДЕ
		|	Заказ.Номер = &Номер";

	Запрос.УстановитьПараметр(
		"Номер",
		НомерЗаказа);

	Выборка =
		Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	// 2. Не нашли — сравниваем по "голым" цифрам без ведущих нулей и
	// префикса (в WMS номер иногда вносят так, как он показан человеку в
	// заголовке формы, например "5", вместо полного "ШМ-005"). Из-за
	// коллизий цифр между разными площадками/поставщиками ОБЯЗАТЕЛЬНО
	// проверяем совпадение поставщика — без него не возвращаем результат
	// вообще, лучше без основания, чем с чужим заказом.
	ЦифрыЗаказа =
		ТолькоЦифрыБезВедущихНулей(
			НомерЗаказа);

	Если ПустаяСтрока(ЦифрыЗаказа)
		Или ИмяКонтрагента = Неопределено
		Или (ПустаяСтрока(Поставщик) И ПустаяСтрока(ПоставщикИНН)) Тогда

		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 200
		|	Заказ.Номер КАК Номер,
		|	Заказ.Ссылка КАК Ссылка"
		+ ПолеКонтрагента + "
		|ИЗ
		|	Документ." + ИмяДокумента + " КАК Заказ
		|ГДЕ
		|	Заказ.Номер ПОДОБНО &Маска
		|УПОРЯДОЧИТЬ ПО
		|	Заказ.Дата УБЫВ";

	Запрос.УстановитьПараметр(
		"Маска",
		"%" + ЦифрыЗаказа);

	Выборка =
		Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Если ТолькоЦифрыБезВедущихНулей(Выборка.Номер) <> ЦифрыЗаказа Тогда
			Продолжить;
		КонецЕсли;

		// ИНН — надежнее: "Наименование" контрагента в 1С часто внутренний
		// короткий алиас, а не то, что написано в накладной, так что
		// текстовое сравнение может не совпасть даже для верного заказа.
		Если ИННСовпадает(Выборка.Контрагент, ПоставщикИНН)
			Или НазванияПоставщикаСовпадают(
				Строка(Выборка.Контрагент),
				Поставщик) Тогда

			Возврат Выборка.Ссылка;
		КонецЕсли;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// В 1С:УНФ отдельного документа "Возврат поставщику" нет — это документ
// "РасходнаяНакладная" с реквизитом Операция = "Возврат поставщику" (см.
// НайтиРеквизитИЗначениеОперацииВозврата). В более старых конфигурациях (УТ/Бухгалтерия)
// бывает отдельный документ вида "ВозвратТоваровПоставщику" — оставлен как
// вариант на случай другой базы.
&НаСервере
Функция НайтиИмяДокументаВозврата()

	Имена = Новый Массив;
	Имена.Добавить("РасходнаяНакладная");
	Имена.Добавить("ВозвратТоваровПоставщику");
	Имена.Добавить("ВозвратПоставщику");
	Имена.Добавить("ВозвратТоваров");

	Для Каждого Имя Из Имена Цикл

		Если Метаданные.Документы.Найти(
			Имя) <> Неопределено Тогда

			Возврат Имя;
		КонецЕсли;

	КонецЦикла;

	ВызватьИсключение
		"Не найден документ возврата поставщику. Проверены: "
		+ СтрСоединить(Имена, ", ") + ".";

КонецФункции

// Пишет в диагностику полный список реквизитов документа (имя, синоним,
// типы) — вызывается, только если не удалось ни найти, ни распознать
// реквизит "Операция". Подпись поля на форме ("Операция:") не обязана
// совпадать с настоящим именем реквизита в метаданных — этот дамп дает
// точный ответ, без гадания по скриншотам формы.
&НаСервере
Процедура ОписатьРеквизитыДокумента(
	МетаОбъект,
	Диагностика)

	Строки = Новый Массив;

	Для Каждого Рекв Из МетаОбъект.Реквизиты Цикл

		ИменаТипов = Новый Массив;
		Для Каждого ТекТип Из Рекв.Тип.Типы() Цикл
			ИменаТипов.Добавить(Строка(ТекТип));
		КонецЦикла;

		Строки.Добавить(
			Рекв.Имя + " (""" + Рекв.Синоним + """): "
			+ СтрСоединить(ИменаТипов, " / "));

	КонецЦикла;

	Диагностика.Добавить(
		"Реквизиты документа """ + МетаОбъект.Имя + """: "
		+ СтрСоединить(Строки, "; "));

КонецПроцедуры

// Ищет у документа реквизит-перечисление или ссылку на справочник вида
// операции ("Операция", "ВидОперации" и т.п. — по имени ИЛИ по синониму,
// подпись на форме может не совпадать с именем реквизита в метаданных) и
// в нем — значение, чей текст (имя/синоним/наименование) содержит
// "возврат" и "поставщ" (регистронезависимо), например
// "ОперацииРасходнойНакладной.ВозвратПоставщику" в 1С:УНФ. Не нашли —
// возвращает Неопределено и пишет в диагностику полный список реквизитов
// документа, чтобы не гадать дальше вслепую; сам документ все равно
// создается — просто с операцией по умолчанию, бухгалтер поправит вручную.
&НаСервере
Функция НайтиРеквизитИЗначениеОперацииВозврата(
	Документ,
	Диагностика)

	МетаОбъект = Документ.Метаданные();

	ИменаРеквизита = Новый Массив;
	ИменаРеквизита.Добавить("Операция");
	ИменаРеквизита.Добавить("ВидОперации");
	ИменаРеквизита.Добавить("ТипОперации");

	РеквизитыДляПроверки = Новый Массив;

	Для Каждого ИмяРеквизита Из ИменаРеквизита Цикл
		Рекв = МетаОбъект.Реквизиты.Найти(ИмяРеквизита);
		Если Рекв <> Неопределено Тогда
			РеквизитыДляПроверки.Добавить(Рекв);
		КонецЕсли;
	КонецЦикла;

	// Плюс — поиск по синониму среди ВСЕХ реквизитов документа: подпись
	// "Операция" на форме может быть у реквизита с любым внутренним именем.
	Для Каждого Рекв Из МетаОбъект.Реквизиты Цикл
		Если СтрНайти(ВРег(Рекв.Синоним), "ОПЕРАЦ") > 0 Тогда
			РеквизитыДляПроверки.Добавить(Рекв);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Рекв Из РеквизитыДляПроверки Цикл

		Для Каждого ТекТип Из Рекв.Тип.Типы() Цикл

			МетаЗначения = Метаданные.НайтиПоТипу(ТекТип);

			Если МетаЗначения = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			// Вариант 1 — перечисление (проверяем принадлежность коллекции
			// Метаданные.Перечисления, а не Тип(...) — системный тип
			// "ОбъектМетаданныхПеречисление" не везде доступен по имени).
			Если Метаданные.Перечисления.Найти(МетаЗначения.Имя) = МетаЗначения Тогда

				Для Каждого ЗначениеМета Из МетаЗначения.ЗначенияПеречисления Цикл

					Текст = ВРег(ЗначениеМета.Имя) + " " + ВРег(ЗначениеМета.Синоним);

					Если СтрНайти(Текст, "ВОЗВРАТ") > 0
						И СтрНайти(Текст, "ПОСТАВЩ") > 0 Тогда

						Значение =
							Перечисления[МетаЗначения.Имя][ЗначениеМета.Имя];

						Диагностика.Добавить(
							"Операция возврата определена (перечисление): "
							+ Рекв.Имя + " = "
							+ МетаЗначения.Имя + "." + ЗначениеМета.Имя);

						Возврат Новый Структура(
							"ИмяРеквизита,Значение",
							Рекв.Имя,
							Значение);
					КонецЕсли;

				КонецЦикла;

			// Вариант 2 — справочник (некоторые конфигурации делают "Вид
			// операции" отдельным справочником, а не перечислением).
			ИначеЕсли Метаданные.Справочники.Найти(МетаЗначения.Имя) = МетаЗначения Тогда

				Попытка
					Запрос = Новый Запрос;
					Запрос.Текст =
						"ВЫБРАТЬ ПЕРВЫЕ 1
						|	Виды.Ссылка КАК Ссылка
						|ИЗ
						|	Справочник." + МетаЗначения.Имя + " КАК Виды
						|ГДЕ
						|	Виды.Наименование ПОДОБНО ""%возврат%поставщ%""
						|	ИЛИ Виды.Наименование ПОДОБНО ""%поставщ%возврат%""";

					Выборка = Запрос.Выполнить().Выбрать();

					Если Выборка.Следующий() Тогда

						Диагностика.Добавить(
							"Операция возврата определена (справочник): "
							+ Рекв.Имя + " = " + Выборка.Ссылка);

						Возврат Новый Структура(
							"ИмяРеквизита,Значение",
							Рекв.Имя,
							Выборка.Ссылка);
					КонецЕсли;

				Исключение
					// Регистронезависимый ПОДОБНО на части СУБД может не
					// сработать — не считаем это фатальной ошибкой поиска.
				КонецПопытки;

			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

	Диагностика.Добавить(
		"ПРЕДУПРЕЖДЕНИЕ: не удалось автоматически определить значение "
		+ "операции ""Возврат поставщику"" — проверьте реквизит вручную.");

	ОписатьРеквизитыДокумента(МетаОбъект, Диагностика);

	Возврат Неопределено;

КонецФункции

// Аналог НайтиРеквизитИЗначениеОперацииВозврата, но для документа
// "Перемещение запасов" (см. СоздатьПеремещениеТоваров) — ищет реквизит
// вида операции и в нем значение, чей текст содержит "перемещ"
// (регистронезависимо), например "Перемещение" в 1С:УНФ. У части баз
// "Перемещение запасов" вообще не различает вид операции (документ и так
// всегда значит одно и то же) — тогда подходящий реквизит просто не
// найдется, это не ошибка.
&НаСервере
Функция НайтиРеквизитИЗначениеОперацииПеремещения(
	Документ,
	Диагностика)

	МетаОбъект = Документ.Метаданные();

	ИменаРеквизита = Новый Массив;
	ИменаРеквизита.Добавить("Операция");
	ИменаРеквизита.Добавить("ВидОперации");
	ИменаРеквизита.Добавить("ТипОперации");

	РеквизитыДляПроверки = Новый Массив;

	Для Каждого ИмяРеквизита Из ИменаРеквизита Цикл
		Рекв = МетаОбъект.Реквизиты.Найти(ИмяРеквизита);
		Если Рекв <> Неопределено Тогда
			РеквизитыДляПроверки.Добавить(Рекв);
		КонецЕсли;
	КонецЦикла;

	// Плюс — поиск по синониму среди ВСЕХ реквизитов документа: подпись
	// "Операция" на форме может быть у реквизита с любым внутренним именем.
	Для Каждого Рекв Из МетаОбъект.Реквизиты Цикл
		Если СтрНайти(ВРег(Рекв.Синоним), "ОПЕРАЦ") > 0 Тогда
			РеквизитыДляПроверки.Добавить(Рекв);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Рекв Из РеквизитыДляПроверки Цикл

		Для Каждого ТекТип Из Рекв.Тип.Типы() Цикл

			МетаЗначения = Метаданные.НайтиПоТипу(ТекТип);

			Если МетаЗначения = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			// Вариант 1 — перечисление.
			Если Метаданные.Перечисления.Найти(МетаЗначения.Имя) = МетаЗначения Тогда

				Для Каждого ЗначениеМета Из МетаЗначения.ЗначенияПеречисления Цикл

					Текст = ВРег(ЗначениеМета.Имя) + " " + ВРег(ЗначениеМета.Синоним);

					Если СтрНайти(Текст, "ПЕРЕМЕЩ") > 0 Тогда

						Значение =
							Перечисления[МетаЗначения.Имя][ЗначениеМета.Имя];

						Диагностика.Добавить(
							"Операция ""Перемещение"" определена (перечисление): "
							+ Рекв.Имя + " = "
							+ МетаЗначения.Имя + "." + ЗначениеМета.Имя);

						Возврат Новый Структура(
							"ИмяРеквизита,Значение",
							Рекв.Имя,
							Значение);
					КонецЕсли;

				КонецЦикла;

			// Вариант 2 — справочник (некоторые конфигурации делают "Вид
			// операции" отдельным справочником, а не перечислением).
			ИначеЕсли Метаданные.Справочники.Найти(МетаЗначения.Имя) = МетаЗначения Тогда

				Попытка
					Запрос = Новый Запрос;
					Запрос.Текст =
						"ВЫБРАТЬ ПЕРВЫЕ 1
						|	Виды.Ссылка КАК Ссылка
						|ИЗ
						|	Справочник." + МетаЗначения.Имя + " КАК Виды
						|ГДЕ
						|	Виды.Наименование ПОДОБНО ""%перемещ%""";

					Выборка = Запрос.Выполнить().Выбрать();

					Если Выборка.Следующий() Тогда

						Диагностика.Добавить(
							"Операция ""Перемещение"" определена (справочник): "
							+ Рекв.Имя + " = " + Выборка.Ссылка);

						Возврат Новый Структура(
							"ИмяРеквизита,Значение",
							Рекв.Имя,
							Выборка.Ссылка);
					КонецЕсли;

				Исключение
					// Регистронезависимый ПОДОБНО на части СУБД может не
					// сработать — не считаем это фатальной ошибкой поиска.
				КонецПопытки;

			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

&НаСервере
Процедура СоздатьВозвратПоставщику(
	Данные)

	НомерНакладной =
		ПолучитьСтроковоеСвойство(
			Данные,
			"invoice_number");

	НомерЗаказа =
		ПолучитьСтроковоеСвойство(
			Данные,
			"order_number");

	ПоставщикWMS =
		ПолучитьСтроковоеСвойство(
			Данные,
			"supplier");

	ПоставщикИНН =
		ПолучитьСтроковоеСвойство(
			Данные,
			"supplier_inn");

	Диагностика = Новый Массив;

	// Вся работа — в Попытке: если что-то упадет на середине (например,
	// не сопоставится товар в одной из строк), накопленную к этому моменту
	// диагностику все равно нужно записать в журнал — иначе при ошибке в
	// журнале не остается вообще ничего, и понять, на каком шаге упало,
	// можно только по тексту исключения в уведомлении на экране.
	Попытка

	ИмяДокумента =
		НайтиИмяДокументаВозврата();

	// Поступление ищем СРАЗУ (а не только ради цен/НДС/договора, как
	// раньше) — если нашлось, создаем возврат "на основании" него через
	// платформенный Заполнить(), а не пустым документом (см. чат). Тогда
	// организацию, валюту, налогообложение, договор и контрагента
	// заполняет сама конфигурация — той же логикой, что и при обычном
	// "Ввод на основании" в интерфейсе, а не наш код вслепую полем за
	// полем. Состав строк из Заполнить() все равно расчищается и
	// собирается заново ниже — накладная целиком не то же самое, что
	// фактически возвращаемые позиции.
	Поступление =
		НайтиПоступлениеПоНомеру(
			НомерНакладной);

	Документ =
		Документы[ИмяДокумента].СоздатьДокумент();

	Если Поступление <> Неопределено Тогда

		Попытка

			Документ.Заполнить(
				Поступление);

			Диагностика.Добавить(
				"Документ создан на основании поступления "
				+ Строка(Поступление) + " (Заполнить()) — организация, "
				+ "валюта, налогообложение, договор и контрагент, если "
				+ "конфигурация их заполняет, взяты автоматически; состав "
				+ "строк ниже собирается заново под фактические позиции "
				+ "возврата.");

		Исключение

			Диагностика.Добавить(
				"ПРЕДУПРЕЖДЕНИЕ: не удалось создать документ на основании "
				+ "поступления " + Строка(Поступление) + ": "
				+ ОписаниеОшибки()
				+ " — документ создан пустым, поля дозаполняются вручную "
				+ "ниже, как раньше.");

		КонецПопытки;

	КонецЕсли;

	Документ.Дата =
		ТекущаяДата();

	Документ.Комментарий =
		ПолучитьСтроковоеСвойство(
			Данные,
			"comment");

	УстановитьОрганизациюЕслиЕсть(
		Документ);

	Склад =
		НайтиСкладПоИмени(
			ПолучитьСтроковоеСвойство(
				Данные,
				"warehouse"));

	ИменаСклада = Новый Массив;
	ИменаСклада.Добавить("Склад");
	ИменаСклада.Добавить("СтруктурнаяЕдиница");

	УстановитьРеквизитСклада(
		Документ,
		ИменаСклада,
		Склад,
		"склад");

	// Поставщик — если документ создан "на основании" поступления (см.
	// Заполнить() выше), контрагент уже определен самой конфигурацией, и
	// трогать его не нужно. Если же документ создан пустым (поступление не
	// нашлось, или Заполнить() сама не справилась) — ищем сами по ИНН/имени
	// в том справочнике, на который реально ссылается найденный реквизит.
	ИмяРеквизитаКонтрагента =
		НайтиИмяРеквизитаКонтрагента(
			Документ.Метаданные());

	Если ИмяРеквизитаКонтрагента <> Неопределено
		И Не ЗначениеЗаполнено(
			Документ[ИмяРеквизитаКонтрагента]) Тогда

		// ИНН — приоритетный способ поиска: "Наименование" в справочнике
		// контрагентов 1С часто внутренний короткий алиас (например, просто
		// "ИП Бедин"), а не то, что напечатано в накладной ("Бедин Денис
		// Ильич") — текстовое совпадение может не найтись вовсе, хотя
		// контрагент в базе есть. По имени ищем только как запасной вариант.
		Контрагент =
			НайтиКонтрагентаПоИНН(
				Документ.Метаданные(),
				ИмяРеквизитаКонтрагента,
				ПоставщикИНН);

		Если Контрагент <> Неопределено Тогда

			Документ[ИмяРеквизитаКонтрагента] =
				Контрагент;

			Диагностика.Добавить(
				"Поставщик определен по ИНН: "
				+ ИмяРеквизитаКонтрагента + " = "
				+ Строка(Контрагент));

		Иначе

			Контрагент =
				НайтиКонтрагентаПоИмени(
					Документ.Метаданные(),
					ИмяРеквизитаКонтрагента,
					ПоставщикWMS);

			Если Контрагент <> Неопределено Тогда

				Документ[ИмяРеквизитаКонтрагента] =
					Контрагент;

				Диагностика.Добавить(
					"Поставщик определен по наименованию: "
					+ ИмяРеквизитаКонтрагента + " = "
					+ Строка(Контрагент));

			ИначеЕсли Не ПустаяСтрока(ПоставщикWMS)
				Или Не ПустаяСтрока(ПоставщикИНН) Тогда

				Диагностика.Добавить(
					"ПРЕДУПРЕЖДЕНИЕ: поставщик """
					+ ПоставщикWMS
					+ """ (ИНН """
					+ ПоставщикИНН
					+ """) не найден в справочнике — привяжите вручную.");
			КонецЕсли;

		КонецЕсли;

	КонецЕсли;

	// Операция — в 1С:УНФ "РасходнаяНакладная" по умолчанию создается как
	// обычная реализация, ее нужно явно переключить на "Возврат поставщику".
	ОперацияВозврата =
		НайтиРеквизитИЗначениеОперацииВозврата(
			Документ,
			Диагностика);

	Если ОперацияВозврата <> Неопределено Тогда
		Документ[ОперацияВозврата.ИмяРеквизита] =
			ОперацияВозврата.Значение;
	КонецЕсли;

	// УПД возврату поставщику не нужен (см. чат) — выключаем.
	ВыключитьУПДЕслиЕсть(
		Документ,
		Диагностика);

	// Цены для строк возврата — из той же приходной накладной, что и выше
	// (см. НайтиЦеныПоступленияПоНоменклатуре). Ищем независимо от того,
	// что дальше станет "Основанием" документа (им в 1С:УНФ обычно является
	// Заказ поставщику, а не само Поступление) — цена в заказе плановая, а
	// в поступлении фактическая закупочная, именно она и нужна для возврата.
	ЦеныПоНоменклатуре =
		НайтиЦеныПоступленияПоНоменклатуре(
			Поступление,
			Диагностика);

	// % НДС по той же логике, что и цены — если в поступлении не нашлось,
	// ДобавитьСтрокуТовара сама подстрахуется ставкой из карточки
	// номенклатуры (см. там).
	НДСПоНоменклатуре =
		НайтиНДСПоступленияПоНоменклатуре(
			Поступление,
			Диагностика);

	// Договор поставщика — как и цены, берем из той же приходной накладной,
	// если он еще не заполнен (документ мог уже создаться "на основании"
	// нее через Заполнить() выше — тогда договор конфигурация подставила
	// сама, перезаписывать не нужно). Нет поступления, договор уже
	// заполнен, или у него/у возврата нет такого реквизита — не считаем
	// это ошибкой, просто не трогаем (бухгалтер укажет вручную).
	Если Поступление <> Неопределено
		И Документ.Метаданные().Реквизиты.Найти(
			"Договор") <> Неопределено
		И Не ЗначениеЗаполнено(
			Документ.Договор) Тогда

		Попытка

			Если Поступление.Метаданные().Реквизиты.Найти(
					"Договор") <> Неопределено Тогда

				ДоговорПоступления =
					Поступление.Договор;

				Если ЗначениеЗаполнено(
						ДоговорПоступления) Тогда

					Документ.Договор =
						ДоговорПоступления;

					Диагностика.Добавить(
						"Договор поставщика определен из поступления "
						+ Строка(Поступление) + ": "
						+ Строка(ДоговорПоступления));
				КонецЕсли;

			КонецЕсли;

		Исключение


			Диагностика.Добавить(
				"ПРЕДУПРЕЖДЕНИЕ: не удалось определить договор поставщика "
				+ "из поступления " + Строка(Поступление) + ": "
				+ ОписаниеОшибки());

		КонецПопытки;

	КонецЕсли;

	// Валюта документа и система налогообложения — та же причина, что и у
	// Договора выше: при программном создании (не "на основании") 1С не
	// подтягивает их сама, а без них часть баз 1С:УНФ вообще не дает
	// провести расходный документ (см. чат — именно эти два поля и
	// колонка "% НДС" ниже были причиной непроводимых возвратов).
	УстановитьВалютуЕслиЕсть(
		Документ,
		Поступление,
		Диагностика);

	УстановитьНалогообложениеЕслиЕсть(
		Документ,
		Диагностика);

	// Основание — приоритет "Заказу поставщику" по номеру заявки, который
	// вносится в WMS вручную при загрузке накладной (see order_number /
	// "№ заявки" в WMS) — так делает возврат в 1С:УНФ (реквизит "Заказ" на
	// РасходнаяНакладная). Если заказ не нашелся или в базе такого реквизита
	// нет — пробуем более старый вариант: документ Поступления по номеру
	// самой накладной (реквизит "Основание", актуально для УТ/Бухгалтерии).
	// Не нашли ничего — возврат все равно создается, просто без основания,
	// для ручной привязки бухгалтером.
	Заказ =
		НайтиЗаказПоставщикуПоНомеру(
			НомерЗаказа,
			ПоставщикWMS,
			ПоставщикИНН);

	ИменаОснованияЗаказа = Новый Массив;
	ИменаОснованияЗаказа.Добавить("Заказ");
	ИменаОснованияЗаказа.Добавить("ЗаказПоставщику");

	Если Заказ <> Неопределено Тогда

		Установлено = Ложь;

		Для Каждого ИмяРеквизита Из ИменаОснованияЗаказа Цикл

			Если Документ.Метаданные().Реквизиты.Найти(
				ИмяРеквизита) <> Неопределено Тогда

				Документ[ИмяРеквизита] =
					Заказ;

				Диагностика.Добавить(
					"Основание установлено: Заказ поставщику "
					+ НомерЗаказа + " (реквизит "
					+ ИмяРеквизита + ")");

				Установлено = Истина;
				Прервать;
			КонецЕсли;

		КонецЦикла;

		Если Не Установлено Тогда
			Диагностика.Добавить(
				"ПРЕДУПРЕЖДЕНИЕ: Заказ поставщику "
				+ НомерЗаказа
				+ " найден, но в документе нет реквизита для его "
				+ "привязки (проверены: "
				+ СтрСоединить(ИменаОснованияЗаказа, ", ") + ").");
		КонецЕсли;

	Иначе

		// Поступление уже найдено выше (см. поиск цен по номеру накладной) —
		// повторно искать его не нужно.
		Если Поступление <> Неопределено Тогда

			Если Документ.Метаданные().Реквизиты.Найти(
				"Основание") <> Неопределено Тогда

				Документ.Основание =
					Поступление;

				Диагностика.Добавить(
					"Основание установлено: Поступление "
					+ НомерНакладной);
			КонецЕсли;

		Иначе
			Диагностика.Добавить(
				"ПРЕДУПРЕЖДЕНИЕ: не найден ни ""Заказ поставщику"" по номеру """
				+ НомерЗаказа
				+ """, ни ""Поступление"" по номеру """
				+ НомерНакладной
				+ """ — возврат создан без основания, привяжите вручную.");
		КонецЕсли;

	КонецЕсли;

	ТЧ =
		НайтиТабличнуюЧастьТоваров(
			Документ);

	// Если документ создан "на основании" поступления (см. Заполнить()
	// выше), сюда могли скопироваться ВСЕ строки накладной с полными
	// количествами — возврат же содержит только часть, реально
	// возвращаемую. Расчищаем и собираем состав заново под фактические
	// позиции WMS ниже — так надежнее, чем подбирать и править скопированные
	// строки по одной.
	Если ТЧ.ТабличнаяЧасть.Количество() > 0 Тогда

		Диагностика.Добавить(
			"В ТЧ после Заполнить() было "
			+ Строка(ТЧ.ТабличнаяЧасть.Количество())
			+ " строк(и) из поступления целиком — очищено, состав "
			+ "собирается заново под фактические позиции возврата.");

		ТЧ.ТабличнаяЧасть.Очистить();

	КонецЕсли;

	ОжидаемыеСтроки =
		Новый Массив;

	Линии =
		ПолучитьСвойствоИлиПустойМассив(
			Данные,
			"lines");

	Если Линии.Количество() = 0 Тогда
		ВызватьИсключение
			"Возврат по накладной " + НомерНакладной
			+ " не содержит строк.";
	КонецЕсли;

	НомерСтроки = 0;

	Для Каждого СтрокаWMS Из Линии Цикл

		НомерСтроки =
			НомерСтроки + 1;

		Количество =
			ПолучитьКоличествоИзСтрокиWMS(
				СтрокаWMS);

		ИменаШтрихкода = Новый Массив;
		ИменаШтрихкода.Добавить("barcode");
		ИменаШтрихкода.Добавить("bar_code");
		ИменаШтрихкода.Добавить("штрихкод");
		ИменаШтрихкода.Добавить("Штрихкод");

		Штрихкод =
			ПолучитьПервоеЗаполненноеСвойство(
				СтрокаWMS,
				ИменаШтрихкода);

		Если Штрихкод = Неопределено Тогда
			Штрихкод = "";
		Иначе
			Штрихкод =
				НормализоватьШтрихкод(
					Штрихкод);
		КонецЕсли;

		ИменаНаименования = Новый Массив;
		ИменаНаименования.Добавить("name");
		ИменаНаименования.Добавить("product_name");
		ИменаНаименования.Добавить("nomenclature_name");
		ИменаНаименования.Добавить("nomenclature");
		ИменаНаименования.Добавить("наименование");

		Наименование =
			ПолучитьПервоеЗаполненноеСвойство(
				СтрокаWMS,
				ИменаНаименования);

		Если Наименование = Неопределено Тогда
			НаименованиеWMS = "";
		Иначе
			НаименованиеWMS =
				СокрЛП(
					Строка(Наименование));
		КонецЕсли;

		ДиагностикаСтроки =
			Новый Массив;

		Товар =
			СопоставитьНоменклатуру(
				СтрокаWMS,
				ДиагностикаСтроки);

		Для Каждого Сообщение Из ДиагностикаСтроки Цикл
			Диагностика.Добавить(
				"Строка "
				+ Строка(НомерСтроки)
				+ ": "
				+ Сообщение);
		КонецЦикла;

		Если Товар = Неопределено Тогда

			ВызватьИсключение
				"Не удалось сопоставить строку "
				+ Строка(НомерСтроки)
				+ " возврата по накладной "
				+ НомерНакладной
				+ ". barcode="""
				+ Штрихкод
				+ """; name="""
				+ НаименованиеWMS
				+ """.";
		КонецЕсли;

		ДобавитьСтрокуТовара(
			ТЧ,
			Товар,
			Количество,
			Штрихкод,
			НаименованиеWMS,
			НомерСтроки,
			Диагностика,
			ЦеныПоНоменклатуре.Получить(Товар),
			НДСПоНоменклатуре.Получить(Товар));

		Ожидаемые =
			Новый Структура(
				"Номенклатура,Количество,Штрихкод",
				Товар,
				Количество,
				Штрихкод);

		ОжидаемыеСтроки.Добавить(
			Ожидаемые);

	КонецЦикла;

	Документ.Записать(
		РежимЗаписиДокумента.Запись);

	ПроверитьТабличнуюЧастьПослеЗаписи(
		Документ,
		ОжидаемыеСтроки,
		Диагностика);

	Исключение

		ТекстОшибки = ОписаниеОшибки();

		Диагностика.Добавить(
			"ОШИБКА: " + ТекстОшибки);

		ЗаписатьДиагностику(
			НомерНакладной,
			Диагностика);

		// Не "ВызватьИсключение;" без параметров (повторный выброс того же
		// исключения) — этот синтаксис появился в платформе не во всех
		// версиях; передаем текст явно, что работает везде.
		ВызватьИсключение
			ТекстОшибки;

	КонецПопытки;

	ЗаписатьДиагностику(
		НомерНакладной,
		Диагностика);

КонецПроцедуры
