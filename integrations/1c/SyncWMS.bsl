// --- Поиск по реквизиту Штрихкод справочника Номенклатура --------------------

&НаСервере
Функция НайтиНоменклатуруПоРеквизитуШтрихкода(
	Штрихкод)

	Если Метаданные.Справочники.Найти(
		"Номенклатура") = Неопределено Тогда

		ВызватьИсключение
			"В конфигурации отсутствует справочник Номенклатура.";
	КонецЕсли;

	Если Метаданные.Справочники.Номенклатура.Реквизиты.Найти(
		"Штрихкод") = Неопределено Тогда

		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;

	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 2
		|	Номенклатура.Ссылка КАК Номенклатура
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Штрихкод = &Штрихкод
		|	И НЕ Номенклатура.ПометкаУдаления";

	Запрос.УстановитьПараметр(
		"Штрихкод",
		Штрихкод);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Номенклатура = Выборка.Номенклатура;

	Если Выборка.Следующий() Тогда
		ВызватьИсключение
			"Штрихкод """ + Штрихкод
			+ """ найден более чем у одной номенклатуры.";
	КонецЕсли;

	Возврат Номенклатура;

КонецФункции

// --- Основной поиск по штрихкоду ---------------------------------------------

&НаСервере
Функция НайтиТоварПоШтрихкоду(
	Штрихкод)

	ШтрихкодНорм = НормализоватьШтрихкод(
		Штрихкод);

	Если ПустаяСтрока(ШтрихкодНорм) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Метаданные.Справочники.Найти(
		"ШтрихкодыНоменклатуры") <> Неопределено Тогда

		Товар = НайтиНоменклатуруВСправочникеШтрихкодов(
			ШтрихкодНорм);

		Если Товар <> Неопределено Тогда
			Возврат Товар;
		КонецЕсли;
	КонецЕсли;

	Если Метаданные.РегистрыСведений.Найти(
		"ШтрихкодыНоменклатуры") <> Неопределено Тогда

		Товар = НайтиНоменклатуруВРегистреШтрихкодов(
			ШтрихкодНорм);

		Если Товар <> Неопределено Тогда
			Возврат Товар;
		КонецЕсли;
	КонецЕсли;

	Товар = НайтиНоменклатуруПоРеквизитуШтрихкода(
		ШтрихкодНорм);

	Если Товар <> Неопределено Тогда
		Возврат Товар;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// --- Точное сопоставление по наименованию -------------------------------

&НаСервере
Функция НайтиНоменклатуруПоТочномуНаименованию(
	Наименование)

	Если ПустаяСтрока(
		СокрЛП(Наименование)) Тогда

		Возврат Неопределено;
	КонецЕсли;

	Номенклатура =
		Справочники.Номенклатура.НайтиПоНаименованию(
			СокрЛП(Наименование),
			Истина);

	Если Номенклатура.Пустая() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Номенклатура;

КонецФункции

// --- Полное сопоставление строки WMS -----------------------------------------

// Приоритет:
//   1. barcode
//   2. точное наименование
//
// Частичного поиска по названию нет.
&НаСервере
Функция СопоставитьНоменклатуру(
	СтрокаWMS,
	Диагностика)

	ИменаШтрихкода = Новый Массив;
	ИменаШтрихкода.Добавить("barcode");
	ИменаШтрихкода.Добавить("bar_code");
	ИменаШтрихкода.Добавить("штрихкод");
	ИменаШтрихкода.Добавить("Штрихкод");

	ИменаНаименования = Новый Массив;
	ИменаНаименования.Добавить("name");
	ИменаНаименования.Добавить("product_name");
	ИменаНаименования.Добавить("nomenclature_name");
	ИменаНаименования.Добавить("nomenclature");
	ИменаНаименования.Добавить("товар");
	ИменаНаименования.Добавить("наименование");

	Штрихкод = ПолучитьПервоеЗаполненноеСвойство(
		СтрокаWMS,
		ИменаШтрихкода);

	Наименование = ПолучитьПервоеЗаполненноеСвойство(
		СтрокаWMS,
		ИменаНаименования);

	Если Штрихкод <> Неопределено Тогда
		Штрихкод = НормализоватьШтрихкод(
			Штрихкод);
	Иначе
		Штрихкод = "";
	КонецЕсли;

	// 1. ШТРИХКОД
	Если Не ПустаяСтрока(Штрихкод) Тогда

		Попытка
			Товар = НайтиТоварПоШтрихкоду(
				Штрихкод);
		Исключение
			Диагностика.Добавить(
				"barcode " + Штрихкод + ": "
				+ ОписаниеОшибки());

			Возврат Неопределено;
		КонецПопытки;

		Если Товар <> Неопределено Тогда
			Диагностика.Добавить(
				"OK: barcode " + Штрихкод
				+ " -> " + Товар.Наименование);

			Возврат Товар;
		КонецЕсли;

		Диагностика.Добавить(
			"barcode " + Штрихкод
			+ " не найден в базе.");

	Иначе
		Диагностика.Добавить(
			"В строке WMS отсутствует barcode.");
	КонецЕсли;

	// 2. ТОЧНОЕ НАИМЕНОВАНИЕ
	Если Наименование <> Неопределено
		И Не ПустаяСтрока(
			Строка(Наименование)) Тогда

		Товар = НайтиНоменклатуруПоТочномуНаименованию(
			Строка(Наименование));

		Если Товар <> Неопределено Тогда

			Диагностика.Добавить(
				"OK: точное наименование -> "
				+ Товар.Наименование);

			Возврат Товар;
		КонецЕсли;

		Диагностика.Добавить(
			"Точное наименование не найдено: "
			+ Строка(Наименование));

	Иначе
		Диагностика.Добавить(
			"В строке WMS отсутствует наименование.");
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// ============================================================================
// СКЛАДЫ / ОРГАНИЗАЦИЯ
// ============================================================================

&НаСервере
Функция НайтиМенеджерСправочникаСкладов()

	Имена = Новый Массив;
	Имена.Добавить("Склады");
	Имена.Добавить("СтруктурныеЕдиницы");
	Имена.Добавить("МестаХранения");
	Имена.Добавить("Хранилища");

	Для Каждого Имя Из Имена Цикл

		Если Метаданные.Справочники.Найти(
			Имя) <> Неопределено Тогда

			Возврат Справочники[Имя];
		КонецЕсли;

	КонецЦикла;

	ВызватьИсключение
		"Не найден справочник складов. Проверены: "
		+ СтрСоединить(Имена, ", ") + ".";

КонецФункции

&НаСервере
Функция НайтиСкладПоИмени(
	Имя)

	Склад =
		НайтиМенеджерСправочникаСкладов().НайтиПоНаименованию(
			Имя,
			Истина);

	Если Склад.Пустая() Тогда
		ВызватьИсключение
			"Не найден склад по точному наименованию: """
			+ Имя + """";
	КонецЕсли;

	Возврат Склад;

КонецФункции

&НаСервере
Процедура УстановитьРеквизитСклада(
	Документ,
	МассивИмен,
	Значение,
	Описание)

	МетаОбъект = Документ.Метаданные();

	Для Каждого Имя Из МассивИмен Цикл

		Если МетаОбъект.Реквизиты.Найти(
			Имя) <> Неопределено Тогда

			Документ[Имя] = Значение;
			Возврат;
		КонецЕсли;

	КонецЦикла;

	ВызватьИсключение
		"В документе """ + МетаОбъект.Синоним
		+ """ не найден реквизит " + Описание
		+ ". Проверены: "
		+ СтрСоединить(МассивИмен, ", ");

КонецПроцедуры

&НаСервере
Процедура УстановитьСкладОтправителя(
	Документ,
	Значение)

	Имена = Новый Массив;
	Имена.Добавить("СкладОтправитель");
	Имена.Добавить("Отправитель");
	Имена.Добавить("СтруктурнаяЕдиница");
	Имена.Добавить("Склад");
	Имена.Добавить("СкладОрдер");
	Имена.Добавить("Помещение");

	УстановитьРеквизитСклада(
		Документ,
		Имена,
		Значение,
		"склад-отправитель");

КонецПроцедуры

&НаСервере
Процедура УстановитьСкладПолучателя(
	Документ,
	Значение)

	Имена = Новый Массив;
	Имена.Добавить("СкладПолучатель");
	Имена.Добавить("Получатель");
	Имена.Добавить("СтруктурнаяЕдиницаПолучатель");

	УстановитьРеквизитСклада(
		Документ,
		Имена,
		Значение,
