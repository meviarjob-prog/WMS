// SyncWMS.bsl
// Синхронизация WMS -> 1С.
//
// Основной принцип:
//   barcode WMS -> ссылка на Справочник.Номенклатура
//   -> заполнение зависимых реквизитов
//   -> проверка строки до и после записи документа.
//
// Документ создается программно (СоздатьДокумент + Записать), без формы —
// обработчики "при изменении" полей формы тут не участвуют, порядок
// присвоения реквизитов сам по себе ни на что не влияет. Проверка после
// записи нужна на случай, если что-то меняет модуль самого документа.
//
// ВАЖНО:
// 1. Токен не хранится в исходнике. Заполните реквизит формы ТокенWMS.
// 2. Документы не проводятся.
// 3. Если строку нельзя однозначно сопоставить с Номенклатурой,
//    документ не записывается и WMS не подтверждается.
// 4. Диагностика пишется в журнал регистрации "ОбменWMS".

&НаКлиенте
Процедура ФормаСинхронизировать(Команда)
	Результат = СинхронизироватьНаСервере();
	Оповестить("WMS: " + Результат);
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если ПустаяСтрока(Объект.АдресWMS) Тогда
		Объект.АдресWMS = "https://wms.wmsmeviar.ru";
	КонецЕсли;

	// Токен намеренно не прописываем в исходнике.
	// Он должен находиться в реквизите формы ТокенWMS.

КонецПроцедуры

// ============================================================================
// СИНХРОНИЗАЦИЯ
// ============================================================================

&НаСервере
Функция СинхронизироватьНаСервере()

	Ответ = ЗапроситьДокументыWMS();

	Если Ответ = Неопределено Тогда
		Возврат "не удалось получить документы (см. журнал регистрации)";
	КонецЕсли;

	ПеренесенныеПеремещения = Новый Массив;
	ПеренесенныеИнвентаризации = Новый Массив;
	Ошибки = Новый Массив;

	МассивПеремещений = ПолучитьСвойствоИлиПустойМассив(Ответ, "movements");

	Для Каждого ДокПеремещения Из МассивПеремещений Цикл
		Попытка
			СоздатьПеремещениеТоваров(ДокПеремещения);
			ПеренесенныеПеремещения.Добавить(
				ПолучитьСвойство(ДокПеремещения, "id", Неопределено));
		Исключение
			Сообщение = "Перемещение "
				+ ПолучитьСтроковоеСвойство(ДокПеремещения, "number")
				+ ": " + ОписаниеОшибки();

			Ошибки.Добавить(Сообщение);

			ЗаписьЖурналаРегистрации(
				"ОбменWMS",
				УровеньЖурналаРегистрации.Ошибка,,,
				Сообщение);
		КонецПопытки;
	КонецЦикла;

	МассивИнвентаризаций = ПолучитьСвойствоИлиПустойМассив(
		Ответ,
		"inventories");

	Для Каждого ДокИнвентаризации Из МассивИнвентаризаций Цикл
		Попытка
			СоздатьИнвентаризациюТоваров(ДокИнвентаризации);
			ПеренесенныеИнвентаризации.Добавить(
				ПолучитьСвойство(ДокИнвентаризации, "id", Неопределено));
		Исключение
			Сообщение = "Инвентаризация "
				+ ПолучитьСтроковоеСвойство(ДокИнвентаризации, "number")
				+ ": " + ОписаниеОшибки();

			Ошибки.Добавить(Сообщение);

			ЗаписьЖурналаРегистрации(
				"ОбменWMS",
				УровеньЖурналаРегистрации.Ошибка,,,
				Сообщение);
		КонецПопытки;
	КонецЦикла;

	ПодтверждениеОтправлено = Истина;

	Если ПеренесенныеПеремещения.Количество() > 0
		Или ПеренесенныеИнвентаризации.Количество() > 0 Тогда

		ПодтверждениеОтправлено = ПодтвердитьПриемWMS(
			ПеренесенныеПеремещения,
			ПеренесенныеИнвентаризации);

	КонецЕсли;

	Если Не ПодтверждениеОтправлено Тогда
		Возврат "создано перемещений "
			+ ПеренесенныеПеремещения.Количество()
			+ ", инвентаризаций "
			+ ПеренесенныеИнвентаризации.Количество()
			+ ", но WMS не подтвердила прием";
	КонецЕсли;

	Результат = "перемещений "
		+ ПеренесенныеПеремещения.Количество()
		+ ", инвентаризаций "
		+ ПеренесенныеИнвентаризации.Количество();

	Если Ошибки.Количество() > 0 Тогда
		Результат = Результат
			+ "; ошибок: " + Ошибки.Количество()
			+ " (см. журнал регистрации ОбменWMS)";
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервере
Функция ЗапроситьДокументыWMS()

	Если ПустаяСтрока(Объект.ТокенWMS) Тогда
		ЗаписьЖурналаРегистрации(
			"ОбменWMS",
			УровеньЖурналаРегистрации.Ошибка,,,
			"Не заполнен реквизит ТокенWMS.");

		Возврат Неопределено;
	КонецЕсли;

	Соединение = НовоеHTTPСоединение();

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("X-1C-Token", Объект.ТокенWMS);

	Запрос = Новый HTTPЗапрос(
		"/integrations/1c/api/export",
		Заголовки);

	Попытка
		Ответ = Соединение.Получить(Запрос);
	Исключение
		ЗаписьЖурналаРегистрации(
			"ОбменWMS",
			УровеньЖурналаРегистрации.Ошибка,,,
			"Ошибка HTTP при получении документов WMS: "
			+ ОписаниеОшибки());

		Возврат Неопределено;
	КонецПопытки;

	Если Ответ = Неопределено
		Или Ответ.КодСостояния <> 200 Тогда

		Код = ?(
			Ответ = Неопределено,
			"нет ответа",
			Строка(Ответ.КодСостояния));

		ЗаписьЖурналаРегистрации(
			"ОбменWMS",
			УровеньЖурналаРегистрации.Ошибка,,,
			"WMS ответил кодом " + Код);

		Возврат Неопределено;
	КонецЕсли;

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(
			Ответ.ПолучитьТелоКакСтроку());

		Результат = ПрочитатьJSON(
			ЧтениеJSON,
			Ложь);

		ЧтениеJSON.Закрыть();

	Исключение
		ЗаписьЖурналаРегистрации(
			"ОбменWMS",
			УровеньЖурналаРегистрации.Ошибка,,,
			"Ошибка разбора JSON от WMS: "
			+ ОписаниеОшибки());

		Возврат Неопределено;
	КонецПопытки;

	Возврат Результат;

КонецФункции

&НаСервере
Функция ПодтвердитьПриемWMS(
	МассивПеремещений,
	МассивИнвентаризаций)

	Тело = Новый Соответствие;
	Тело.Вставить("movement_ids", МассивПеремещений);
	Тело.Вставить("inventory_ids", МассивИнвентаризаций);

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();

	ЗаписатьJSON(
		ЗаписьJSON,
		Тело);

	СтрокаТела = ЗаписьJSON.Закрыть();

	Соединение = НовоеHTTPСоединение();

	Заголовки = Новый Соответствие;
	Заголовки.Вставить(
		"X-1C-Token",
		Объект.ТокенWMS);

	Заголовки.Вставить(
		"Content-Type",
		"application/json");

	Запрос = Новый HTTPЗапрос(
		"/integrations/1c/api/export/confirm",
		Заголовки);

	Запрос.УстановитьТелоИзСтроки(СтрокаТела);

	Попытка
		Ответ = Соединение.ВызватьHTTPМетод(
			"POST",
			Запрос);
	Исключение
		ЗаписьЖурналаРегистрации(
			"ОбменWMS",
			УровеньЖурналаРегистрации.Ошибка,,,
			"Не удалось отправить подтверждение в WMS: "
			+ ОписаниеОшибки());

		Возврат Ложь;
	КонецПопытки;

	Если Ответ = Неопределено
		Или Ответ.КодСостояния < 200
		Или Ответ.КодСостояния >= 300 Тогда

		КодОтвета = ?(
			Ответ = Неопределено,
			"нет ответа",
			Строка(Ответ.КодСостояния));

		ЗаписьЖурналаРегистрации(
			"ОбменWMS",
			УровеньЖурналаРегистрации.Ошибка,,,
			"WMS не подтвердила прием документов, код ответа: "
			+ КодОтвета);

		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

&НаСервере
Функция НовоеHTTPСоединение()

	АдресРазобранный = СтрЗаменить(
		Объект.АдресWMS,
		"https://",
		"");

	АдресРазобранный = СтрЗаменить(
		АдресРазобранный,
		"http://",
		"");

	ИспользоватьЗащищенное =
		СтрНачинаетсяС(
			Объект.АдресWMS,
			"https://");

	Возврат Новый HTTPСоединение(
		АдресРазобранный,
		,,,,,,
		ИспользоватьЗащищенное);

КонецФункции

// ============================================================================
// УТИЛИТЫ JSON
// ============================================================================

&НаСервере
Функция ПолучитьСвойство(
	Данные,
	Имя,
	ЗначениеПоУмолчанию = Неопределено)

	Если Данные = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Значение = Неопределено;

	Попытка
		Если Данные.Свойство(
			Имя,
			Значение) Тогда

			Возврат Значение;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

&НаСервере
Функция ПолучитьСтроковоеСвойство(
	Данные,
	Имя)

	Значение = ПолучитьСвойство(
		Данные,
		Имя,
		"");

	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат Строка(Значение);

КонецФункции

&НаСервере
Функция ПолучитьСвойствоИлиПустойМассив(
	Данные,
	Имя)

	Значение = ПолучитьСвойство(
		Данные,
		Имя,
		Неопределено);

	Если Значение = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Возврат Значение;

КонецФункции

&НаСервере
Функция ПолучитьПервоеЗаполненноеСвойство(
	Данные,
	Имена)

	Для Каждого Имя Из Имена Цикл

		Значение = ПолучитьСвойство(
			Данные,
			Имя,
			Неопределено);

		Если Значение <> Неопределено
			И ЗначениеЗаполнено(Значение) Тогда

			Возврат Значение;
		КонецЕсли;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// ============================================================================
// НОМЕНКЛАТУРА
// ============================================================================

// Ведущие нули НЕ удаляются.
&НаСервере
Функция НормализоватьШтрихкод(Штрихкод)

	Если Штрихкод = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Результат = СокрЛП(
		Строка(Штрихкод));

	Результат = СтрЗаменить(
		Результат,
		" ",
		"");

	Результат = СтрЗаменить(
		Результат,
		"-",
		"");

	Возврат Результат;

КонецФункции

// --- Поиск в справочнике ШтрихкодыНоменклатуры -------------------------------

&НаСервере
Функция НайтиНоменклатуруВСправочникеШтрихкодов(
	Штрихкод)

	Если Метаданные.Справочники.Найти(
		"ШтрихкодыНоменклатуры") = Неопределено Тогда

		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Запрос = Новый Запрос;

		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 2
			|	Штрихкоды.Владелец КАК Номенклатура
			|ИЗ
			|	Справочник.ШтрихкодыНоменклатуры КАК Штрихкоды
			|ГДЕ
			|	Штрихкоды.Штрихкод = &Штрихкод";

		Запрос.УстановитьПараметр(
			"Штрихкод",
			Штрихкод);

		Выборка = Запрос.Выполнить().Выбрать();

		Если Не Выборка.Следующий() Тогда
			Возврат Неопределено;
		КонецЕсли;

		Номенклатура = Выборка.Номенклатура;

		Если Выборка.Следующий() Тогда
			ВызватьИсключение
				"Штрихкод """ + Штрихкод
				+ """ привязан более чем к одной номенклатуре.";
		КонецЕсли;

		Возврат Номенклатура;

	Исключение
		ВызватьИсключение
			"Ошибка поиска в справочнике ШтрихкодыНоменклатуры: "
			+ ОписаниеОшибки();
	КонецПопытки;

КонецФункции

// --- Поиск в регистре ШтрихкодыНоменклатуры -------------------------------

&НаСервере
Функция НайтиНоменклатуруВРегистреШтрихкодов(
	Штрихкод)

	Если Метаданные.РегистрыСведений.Найти(
		"ШтрихкодыНоменклатуры") = Неопределено Тогда

		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Запрос = Новый Запрос;

		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 2
			|	Штрихкоды.Номенклатура КАК Номенклатура
			|ИЗ
			|	РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
			|ГДЕ
			|	Штрихкоды.Штрихкод = &Штрихкод";

		Запрос.УстановитьПараметр(
			"Штрихкод",
			Штрихкод);

		Выборка = Запрос.Выполнить().Выбрать();

		Если Не Выборка.Следующий() Тогда
			Возврат Неопределено;
		КонецЕсли;

		Номенклатура = Выборка.Номенклатура;

		Если Выборка.Следующий() Тогда
			ВызватьИсключение
				"Штрихкод """ + Штрихкод
				+ """ найден более чем у одной записи регистра.";
		КонецЕсли;

		Возврат Номенклатура;

	Исключение
		ВызватьИсключение
			"Ошибка поиска в регистре ШтрихкодыНоменклатуры: "
			+ ОписаниеОшибки();
	КонецПопытки;

КонецФункции

// --- Поиск по реквизиту Штрихкод справочника Номенклатура --------------------

&НаСервере
Функция НайтиНоменклатуруПоРеквизитуШтрихкода(
	Штрихкод)

	Если Метаданные.Справочники.Найти(
		"Номенклатура") = Неопределено Тогда

		ВызватьИсключение
			"В конфигурации отсутствует справочник Номенклатура.";
	КонецЕсли;

	Если Метаданные.Справочники.Номенклатура.Реквизиты.Найти(
		"Штрихкод") = Неопределено Тогда

		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;

	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 2
		|	Номенклатура.Ссылка КАК Номенклатура
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Штрихкод = &Штрихкод
		|	И НЕ Номенклатура.ПометкаУдаления";

	Запрос.УстановитьПараметр(
		"Штрихкод",
		Штрихкод);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Номенклатура = Выборка.Номенклатура;

	Если Выборка.Следующий() Тогда
		ВызватьИсключение
			"Штрихкод """ + Штрихкод
			+ """ найден более чем у одной номенклатуры.";
	КонецЕсли;

	Возврат Номенклатура;

КонецФункции

// --- Основной поиск по штрихкоду ---------------------------------------------

&НаСервере
Функция НайтиТоварПоШтрихкоду(
	Штрихкод)

	ШтрихкодНорм = НормализоватьШтрихкод(
		Штрихкод);

	Если ПустаяСтрока(ШтрихкодНорм) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Метаданные.Справочники.Найти(
		"ШтрихкодыНоменклатуры") <> Неопределено Тогда

		Товар = НайтиНоменклатуруВСправочникеШтрихкодов(
			ШтрихкодНорм);

		Если Товар <> Неопределено Тогда
			Возврат Товар;
		КонецЕсли;
	КонецЕсли;

	Если Метаданные.РегистрыСведений.Найти(
		"ШтрихкодыНоменклатуры") <> Неопределено Тогда

		Товар = НайтиНоменклатуруВРегистреШтрихкодов(
			ШтрихкодНорм);

		Если Товар <> Неопределено Тогда
			Возврат Товар;
		КонецЕсли;
	КонецЕсли;

	Товар = НайтиНоменклатуруПоРеквизитуШтрихкода(
		ШтрихкодНорм);

	Если Товар <> Неопределено Тогда
		Возврат Товар;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// --- Точное сопоставление по наименованию -------------------------------

&НаСервере
Функция НайтиНоменклатуруПоТочномуНаименованию(
	Наименование)

	Если ПустаяСтрока(
		СокрЛП(Наименование)) Тогда

		Возврат Неопределено;
	КонецЕсли;

	Номенклатура =
		Справочники.Номенклатура.НайтиПоНаименованию(
			СокрЛП(Наименование),
			Истина);

	Если Номенклатура.Пустая() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Номенклатура;

КонецФункции

// --- Полное сопоставление строки WMS -----------------------------------------

// Приоритет:
//   1. barcode
//   2. точное наименование
//
// Частичного поиска по названию нет.
&НаСервере
Функция СопоставитьНоменклатуру(
	СтрокаWMS,
	Диагностика)

	ИменаШтрихкода = Новый Массив;
	ИменаШтрихкода.Добавить("barcode");
	ИменаШтрихкода.Добавить("bar_code");
	ИменаШтрихкода.Добавить("штрихкод");
	ИменаШтрихкода.Добавить("Штрихкод");

	ИменаНаименования = Новый Массив;
	ИменаНаименования.Добавить("name");
	ИменаНаименования.Добавить("product_name");
	ИменаНаименования.Добавить("nomenclature_name");
	ИменаНаименования.Добавить("nomenclature");
	ИменаНаименования.Добавить("товар");
	ИменаНаименования.Добавить("наименование");

	Штрихкод = ПолучитьПервоеЗаполненноеСвойство(
		СтрокаWMS,
		ИменаШтрихкода);

	Наименование = ПолучитьПервоеЗаполненноеСвойство(
		СтрокаWMS,
		ИменаНаименования);

	Если Штрихкод <> Неопределено Тогда
		Штрихкод = НормализоватьШтрихкод(
			Штрихкод);
	Иначе
		Штрихкод = "";
	КонецЕсли;

	// 1. ШТРИХКОД
	Если Не ПустаяСтрока(Штрихкод) Тогда

		Попытка
			Товар = НайтиТоварПоШтрихкоду(
				Штрихкод);
		Исключение
			Диагностика.Добавить(
				"barcode " + Штрихкод + ": "
				+ ОписаниеОшибки());

			Возврат Неопределено;
		КонецПопытки;

		Если Товар <> Неопределено Тогда
			Диагностика.Добавить(
				"OK: barcode " + Штрихкод
				+ " -> " + Товар.Наименование);

			Возврат Товар;
		КонецЕсли;

		Диагностика.Добавить(
			"barcode " + Штрихкод
			+ " не найден в базе.");

	Иначе
		Диагностика.Добавить(
			"В строке WMS отсутствует barcode.");
	КонецЕсли;

	// 2. ТОЧНОЕ НАИМЕНОВАНИЕ
	Если Наименование <> Неопределено
		И Не ПустаяСтрока(
			Строка(Наименование)) Тогда

		Товар = НайтиНоменклатуруПоТочномуНаименованию(
			Строка(Наименование));

		Если Товар <> Неопределено Тогда

			Диагностика.Добавить(
				"OK: точное наименование -> "
				+ Товар.Наименование);

			Возврат Товар;
		КонецЕсли;

		Диагностика.Добавить(
			"Точное наименование не найдено: "
			+ Строка(Наименование));

	Иначе
		Диагностика.Добавить(
			"В строке WMS отсутствует наименование.");
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

