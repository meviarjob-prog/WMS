// Обработчик кнопки "Синхронизировать" внешней обработки обмена с WMS.
// Реквизиты формы, которые нужно завести заранее:
//   АдресWMS  (Строка) — например "https://wms.wmsmeviar.ru"
//   ТокенWMS  (Строка) — токен из WMS: меню "Обмен с 1С" (только админ)
//
// Смысл: забрать из WMS завершенные и еще не перенесенные документы
// перемещения/инвентаризации, создать по ним черновики (НЕ проведенные)
// документов 1С с номером WMS-документа в комментарии, и подтвердить
// WMS, что документы приняты — чтобы при повторном нажатии кнопки они
// не создались еще раз.

// Имя процедуры-обработчика зависит от того, как 1С назвала команду при
// создании (обычно "Форма"+имя команды, например ФормаСинхронизировать) —
// если у вас команда называется иначе, переименуйте здесь.
&НаКлиенте
Процедура ФормаСинхронизировать(Команда)
	Результат = СинхронизироватьНаСервере();
	Оповестить("WMS: " + Результат);
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если ПустаяСтрока(Объект.АдресWMS) Тогда
		Объект.АдресWMS = "https://wms.wmsmeviar.ru";
	КонецЕсли;
	Если ПустаяСтрока(Объект.ТокенWMS) Тогда
		Объект.ТокенWMS = "IJ-hx0S32TyFcBaCbU-M6EuCiRNhPTqa";
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция СинхронизироватьНаСервере()

	Ответ = ЗапроситьДокументыWMS();
	Если Ответ = Неопределено Тогда
		Возврат "не удалось получить документы (см. журнал регистрации)";
	КонецЕсли;

	ПеренесенныеПеремещения = Новый Массив;
	ПеренесенныеИнвентаризации = Новый Массив;

	Для Каждого ДокПеремещения Из Ответ.movements Цикл
		Попытка
			СоздатьПеремещениеТоваров(ДокПеремещения);
			ПеренесенныеПеремещения.Добавить(ДокПеремещения.id);
		Исключение
			ЗаписьЖурналаРегистрации(
				"ОбменWMS",
				УровеньЖурналаРегистрации.Ошибка,,,
				"Перемещение " + ДокПеремещения.number + ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	Для Каждого ДокИнвентаризации Из Ответ.inventories Цикл
		Попытка
			СоздатьИнвентаризациюТоваров(ДокИнвентаризации);
			ПеренесенныеИнвентаризации.Добавить(ДокИнвентаризации.id);
		Исключение
			ЗаписьЖурналаРегистрации(
				"ОбменWMS",
				УровеньЖурналаРегистрации.Ошибка,,,
				"Инвентаризация " + ДокИнвентаризации.number + ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	ПодтверждениеОтправлено = Истина;
	Если ПеренесенныеПеремещения.Количество() > 0 Или ПеренесенныеИнвентаризации.Количество() > 0 Тогда
		ПодтверждениеОтправлено = ПодтвердитьПриемWMS(ПеренесенныеПеремещения, ПеренесенныеИнвентаризации);
	КонецЕсли;

	Если Не ПодтверждениеОтправлено Тогда
		Возврат "документы созданы (" + ПеренесенныеПеремещения.Количество() + " перемещ., "
			+ ПеренесенныеИнвентаризации.Количество() + " инвент.), НО WMS не подтвердила прием — "
			+ "при следующей синхронизации они создадутся заново! Смотрите журнал регистрации.";
	КонецЕсли;

	Возврат "перемещений " + ПеренесенныеПеремещения.Количество()
		+ ", инвентаризаций " + ПеренесенныеИнвентаризации.Количество();

КонецФункции

&НаСервере
Функция ЗапроситьДокументыWMS()

	Соединение = НовоеHTTPСоединение();
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("X-1C-Token", Объект.ТокенWMS);
	Запрос = Новый HTTPЗапрос("/integrations/1c/api/export", Заголовки);

	Ответ = Соединение.Получить(Запрос);
	Если Ответ.КодСостояния <> 200 Тогда
		ЗаписьЖурналаРегистрации("ОбменWMS", УровеньЖурналаРегистрации.Ошибка,,,
			"WMS ответил кодом " + Ответ.КодСостояния);
		Возврат Неопределено;
	КонецЕсли;

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
	Результат = ПрочитатьJSON(ЧтениеJSON, Ложь);
	ЧтениеJSON.Закрыть();
	Возврат Результат;

КонецФункции

&НаСервере
Функция ПодтвердитьПриемWMS(МассивПеремещений, МассивИнвентаризаций)

	Тело = Новый Соответствие;
	Тело.Вставить("movement_ids", МассивПеремещений);
	Тело.Вставить("inventory_ids", МассивИнвентаризаций);

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Тело);
	СтрокаТела = ЗаписьJSON.Закрыть();

	Соединение = НовоеHTTPСоединение();
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("X-1C-Token", Объект.ТокенWMS);
	Заголовки.Вставить("Content-Type", "application/json");
	Запрос = Новый HTTPЗапрос("/integrations/1c/api/export/confirm", Заголовки);
	Запрос.УстановитьТелоИзСтроки(СтрокаТела);

	Попытка
		// ВызватьHTTPМетод — универсальный способ сделать POST (в отличие от
		// специализированного метода "Отправить", который есть не на всех
		// платформах/сборках).
		Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);
	Исключение
		ЗаписьЖурналаРегистрации("ОбменWMS", УровеньЖурналаРегистрации.Ошибка,,,
			"Не удалось отправить подтверждение в WMS: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;

	// Возвращает то же, что и Получить — объект ответа с КодСостояния. Если
	// сайт вернул не 200 (например, 401 из-за неверного токена, или 500) —
	// документы в WMS НЕ будут помечены перенесенными, и при следующем
	// нажатии кнопки создадутся заново. Это самое частое место тихого
	// сбоя — обязательно проверяем код ответа.
	Если Ответ = Неопределено Или Ответ.КодСостояния <> 200 Тогда
		КодОтвета = ?(Ответ = Неопределено, "нет ответа", Строка(Ответ.КодСостояния));
		ЗаписьЖурналаРегистрации("ОбменWMS", УровеньЖурналаРегистрации.Ошибка,,,
			"WMS не подтвердила прием документов, код ответа: " + КодОтвета);
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

&НаСервере
Функция НовоеHTTPСоединение()
	АдресРазобранный = СтрЗаменить(Объект.АдресWMS, "https://", "");
	АдресРазобранный = СтрЗаменить(АдресРазобранный, "http://", "");
	ИспользоватьЗащищенное = СтрНачинаетсяС(Объект.АдресWMS, "https://");
	Возврат Новый HTTPСоединение(АдресРазобранный,, , , , , ИспользоватьЗащищенное);
КонецФункции

// Штрихкоды в разных конфигурациях хранятся по-разному. Проверяем по
// метаданным базы несколько типовых вариантов и используем тот, что
// реально есть. Если не подошел ни один — поправьте эту функцию под
// структуру вашей базы (может быть, например, свой штрихкод у
// характеристик номенклатуры — размер/цвет).
&НаСервере
Функция НайтиТоварПоШтрихкоду(Штрихкод)

	// Вариант 1: отдельный справочник штрихкодов (типовой для 1С:УНФ).
	Если Метаданные.Справочники.Найти("ШтрихкодыНоменклатуры") <> Неопределено Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Штрихкоды.Владелец КАК Номенклатура
			|ИЗ
			|	Справочник.ШтрихкодыНоменклатуры КАК Штрихкоды
			|ГДЕ
			|	Штрихкоды.Штрихкод = &Штрихкод";
		Запрос.УстановитьПараметр("Штрихкод", Штрихкод);
		Выборка = Запрос.Выполнить().Выбрать();
		Возврат ?(Выборка.Следующий(), Выборка.Номенклатура, Неопределено);
	КонецЕсли;

	// Вариант 2: регистр сведений штрихкодов (типовой для УТ/ERP/КА).
	Если Метаданные.РегистрыСведений.Найти("ШтрихкодыНоменклатуры") <> Неопределено Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Штрихкоды.Номенклатура КАК Номенклатура
			|ИЗ
			|	РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
			|ГДЕ
			|	Штрихкоды.Штрихкод = &Штрихкод";
		Запрос.УстановитьПараметр("Штрихкод", Штрихкод);
		Выборка = Запрос.Выполнить().Выбрать();
		Возврат ?(Выборка.Следующий(), Выборка.Номенклатура, Неопределено);
	КонецЕсли;

	// Вариант 3: штрихкод — реквизит прямо у справочника Номенклатура.
	Если Метаданные.Справочники.Номенклатура.Реквизиты.Найти("Штрихкод") <> Неопределено Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Номенклатура.Ссылка КАК Номенклатура
			|ИЗ
			|	Справочник.Номенклатура КАК Номенклатура
			|ГДЕ
			|	Номенклатура.Штрихкод = &Штрихкод";
		Запрос.УстановитьПараметр("Штрихкод", Штрихкод);
		Выборка = Запрос.Выполнить().Выбрать();
		Возврат ?(Выборка.Следующий(), Выборка.Номенклатура, Неопределено);
	КонецЕсли;

	ВызватьИсключение "Не удалось определить, где в базе хранятся штрихкоды номенклатуры "
		+ "(проверены: справочник ШтрихкодыНоменклатуры, регистр сведений ШтрихкодыНоменклатуры, "
		+ "реквизит Штрихкод у Номенклатуры). Поправьте функцию НайтиТоварПоШтрихкоду в SyncWMS.bsl.";

КонецФункции

// Как и с реквизитами документа выше — справочник складов тоже называется
// по-разному в разных конфигурациях. Ищем по метаданным, какой из
// известных справочников реально есть в базе.
&НаСервере
Функция НайтиМенеджерСправочникаСкладов()
	Имена = Новый Массив;
	Имена.Добавить("Склады");
	Имена.Добавить("СтруктурныеЕдиницы");
	Имена.Добавить("МестаХранения");
	Имена.Добавить("Хранилища");
	Для Каждого Имя Из Имена Цикл
		Если Метаданные.Справочники.Найти(Имя) <> Неопределено Тогда
			Возврат Справочники[Имя];
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Не найден справочник складов — проверены имена: " + СтрСоединить(Имена, ", ")
		+ ". Уточните точное имя справочника (Конфигуратор → Справочники) и добавьте его в список в SyncWMS.bsl.";
КонецФункции

// TODO: если склады в WMS и 1С называются по-разному — замените поиск по
// имени на свою таблицу соответствия.
&НаСервере
Функция НайтиСкладПоИмени(Имя)
	Возврат НайтиМенеджерСправочникаСкладов().НайтиПоНаименованию(Имя, Истина);
КонецФункции

// Разные конфигурации 1С (и разные доработки одной и той же конфигурации)
// называют реквизиты склада-отправителя/получателя по-разному. Вместо
// того чтобы гадать конкретное имя, проверяем по метаданным документа,
// какое из известных имен у него реально есть, и пишем в него.
// Если ни одно имя не подошло — пополните соответствующий список ниже
// точным именем реквизита из вашей конфигурации (Конфигуратор →
// документ → вкладка "Данные" → "Реквизиты").
&НаСервере
Процедура УстановитьРеквизитСклада(Документ, МассивИмен, Значение, Описание)
	МетаОбъект = Документ.Метаданные();
	Для Каждого Имя Из МассивИмен Цикл
		Если МетаОбъект.Реквизиты.Найти(Имя) <> Неопределено Тогда
			Документ[Имя] = Значение;
			Возврат;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "В документе """ + МетаОбъект.Синоним + """ не найден реквизит """
		+ Описание + """ — проверены имена: " + СтрСоединить(МассивИмен, ", ")
		+ ". Добавьте точное имя реквизита в список в SyncWMS.bsl.";
КонецПроцедуры

&НаСервере
Процедура УстановитьСкладОтправителя(Документ, Значение)
	Имена = Новый Массив;
	Имена.Добавить("СкладОтправитель");
	Имена.Добавить("Отправитель");
	Имена.Добавить("СтруктурнаяЕдиница");
	Имена.Добавить("Склад");
	Имена.Добавить("СкладОрдер");
	Имена.Добавить("Помещение");
	УстановитьРеквизитСклада(Документ, Имена, Значение, "склад-отправитель");
КонецПроцедуры

&НаСервере
Процедура УстановитьСкладПолучателя(Документ, Значение)
	Имена = Новый Массив;
	Имена.Добавить("СкладПолучатель");
	Имена.Добавить("Получатель");
	Имена.Добавить("СтруктурнаяЕдиницаПолучатель");
	УстановитьРеквизитСклада(Документ, Имена, Значение, "склад-получатель");
КонецПроцедуры

// Организаций в базе несколько — документы обмена с WMS создаются от
// имени этой конкретной организации. Если понадобится другая, поменяйте
// имя ниже.
&НаСервере
Функция НайтиОрганизациюПоУмолчанию()
	Организация = Справочники.Организации.НайтиПоНаименованию("ТОР-ФАРМ ООО", Истина);
	Если Организация.Пустая() Тогда
		ВызватьИсключение "Не найдена организация ""ТОР-ФАРМ ООО"" в справочнике Организации.";
	КонецЕсли;
	Возврат Организация;
КонецФункции

// В однофирменных/упрощенных конфигурациях у документа может вообще не
// быть реквизита "Организация" — тогда его просто не заполняем.
&НаСервере
Процедура УстановитьОрганизациюЕслиЕсть(Документ)
	Если Документ.Метаданные().Реквизиты.Найти("Организация") <> Неопределено Тогда
		Документ.Организация = НайтиОрганизациюПоУмолчанию();
	КонецЕсли;
КонецПроцедуры

// Табличная часть с товарами тоже называется по-разному (Товары, Запасы,
// Продукция...) — находим ее по метаданным документа. Возвращает саму
// табличную часть и ее метаданные (для поиска колонок).
&НаСервере
Функция НайтиТабличнуюЧастьТоваров(Документ)
	Имена = Новый Массив;
	Имена.Добавить("Товары");
	Имена.Добавить("Запасы");
	Имена.Добавить("Продукция");
	Имена.Добавить("Материалы");
	Имена.Добавить("Позиции");
	МетаОбъект = Документ.Метаданные();
	Для Каждого Имя Из Имена Цикл
		МетаТЧ = МетаОбъект.ТабличныеЧасти.Найти(Имя);
		Если МетаТЧ <> Неопределено Тогда
			Возврат Новый Структура("ТабличнаяЧасть, Метаданные", Документ[Имя], МетаТЧ);
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "В документе """ + МетаОбъект.Синоним + """ не найдена табличная часть товаров"
		+ " — проверены имена: " + СтрСоединить(Имена, ", ")
		+ ". Добавьте точное имя табличной части в список в SyncWMS.bsl.";
КонецФункции

// Заполняет одну строку табличной части товаров, тоже подбирая реальные
// имена колонок "номенклатура" и "количество" по метаданным.
&НаСервере
Процедура ДобавитьСтрокуТовара(ТЧ, Товар, Количество)
	ИменаНоменклатуры = Новый Массив;
	ИменаНоменклатуры.Добавить("Номенклатура");
	ИменаНоменклатуры.Добавить("Товар");
	ИменаНоменклатуры.Добавить("Продукция");

	ИменаКоличества = Новый Массив;
	ИменаКоличества.Добавить("Количество");
	ИменаКоличества.Добавить("Кол");

	НоваяСтрока = ТЧ.ТабличнаяЧасть.Добавить();

	ИмяНоменклатуры = Неопределено;
	Для Каждого Имя Из ИменаНоменклатуры Цикл
		Если ТЧ.Метаданные.Реквизиты.Найти(Имя) <> Неопределено Тогда
			ИмяНоменклатуры = Имя;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ИмяНоменклатуры = Неопределено Тогда
		ВызватьИсключение "В табличной части """ + ТЧ.Метаданные.Синоним + """ не найдена колонка "
			+ "номенклатуры — проверены имена: " + СтрСоединить(ИменаНоменклатуры, ", ")
			+ ". Добавьте точное имя колонки в SyncWMS.bsl.";
	КонецЕсли;
	НоваяСтрока[ИмяНоменклатуры] = Товар;

	ИмяКоличества = Неопределено;
	Для Каждого Имя Из ИменаКоличества Цикл
		Если ТЧ.Метаданные.Реквизиты.Найти(Имя) <> Неопределено Тогда
			ИмяКоличества = Имя;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ИмяКоличества = Неопределено Тогда
		ВызватьИсключение "В табличной части """ + ТЧ.Метаданные.Синоним + """ не найдена колонка "
			+ "количества — проверены имена: " + СтрСоединить(ИменаКоличества, ", ")
			+ ". Добавьте точное имя колонки в SyncWMS.bsl.";
	КонецЕсли;
	НоваяСтрока[ИмяКоличества] = Количество;
КонецПроцедуры

&НаСервере
Процедура СоздатьПеремещениеТоваров(Данные)
	Документ = Документы.ПеремещениеЗапасов.СоздатьДокумент();
	Документ.Дата = ТекущаяДата();
	Документ.Комментарий = Данные.comment;
	УстановитьСкладОтправителя(Документ, НайтиСкладПоИмени(Данные.from_warehouse));
	УстановитьСкладПолучателя(Документ, НайтиСкладПоИмени(Данные.to_warehouse));
	УстановитьОрганизациюЕслиЕсть(Документ);

	ТЧ = НайтиТабличнуюЧастьТоваров(Документ);
	Для Каждого Строка Из Данные.lines Цикл
		Товар = НайтиТоварПоШтрихкоду(Строка.barcode);
		Если Товар = Неопределено Тогда
			ВызватьИсключение "Не найден товар по штрихкоду " + Строка.barcode;
		КонецЕсли;
		ДобавитьСтрокуТовара(ТЧ, Товар, Строка.qty);
	КонецЦикла;

	// Сознательно не проводим — только записываем черновиком.
	Документ.Записать(РежимЗаписиДокумента.Запись);
КонецПроцедуры

&НаСервере
Процедура СоздатьИнвентаризациюТоваров(Данные)
	Документ = Документы.ИнвентаризацияЗапасов.СоздатьДокумент();
	Документ.Дата = ТекущаяДата();
	Документ.Комментарий = Данные.comment;
	Имена = Новый Массив;
	Имена.Добавить("Склад");
	Имена.Добавить("СтруктурнаяЕдиница");
	Имена.Добавить("Помещение");
	УстановитьРеквизитСклада(Документ, Имена, НайтиСкладПоИмени(Данные.warehouse), "склад");
	УстановитьОрганизациюЕслиЕсть(Документ);

	ТЧ = НайтиТабличнуюЧастьТоваров(Документ);
	Для Каждого Строка Из Данные.lines Цикл
		Товар = НайтиТоварПоШтрихкоду(Строка.barcode);
		Если Товар = Неопределено Тогда
			ВызватьИсключение "Не найден товар по штрихкоду " + Строка.barcode;
		КонецЕсли;
		ДобавитьСтрокуТовара(ТЧ, Товар, Строка.qty);
	КонецЦикла;

	Документ.Записать(РежимЗаписиДокумента.Запись);
КонецПроцедуры
